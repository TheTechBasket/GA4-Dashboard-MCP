# Point at a service-account JSON key file on disk (not committed).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Needed only for run_pagespeed_insights — plain API key, not the service account.
# PSI_API_KEY=...

# Optional tuning (sane defaults are baked in, override only if needed)
# RATE_LIMIT_ADMIN_RPS=2
# RATE_LIMIT_DATA_RPS=8
# RATE_LIMIT_REALTIME_RPS=4
# RATE_LIMIT_PSI_RPS=1
# RATE_LIMIT_INDEXING_RPS=0.1
# CACHE_TTL_REALTIME_SEC=60
# CACHE_TTL_REPORT_SEC=3600
# CACHE_TTL_METADATA_SEC=21600
# CACHE_TTL_PSI_SEC=1800
