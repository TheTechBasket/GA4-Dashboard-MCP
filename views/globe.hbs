</div>

<div id="panel-feed">
  <div class="feed-header">Live Visitors</div>
  <div class="feed-list" id="feedList">
    <div class="feed-item" style="opacity:.4"><span style="color:var(--g-muted)">Waiting for data…</span></div>
  </div>
</div>

<div id="panel-meta">
  <div>Updated <span id="glFetchedAt">—</span></div>
  <div>↻ in <span id="glCountdown" style="font-family:var(--g-mono)">—</span></div>
</div>

<script src="https://unpkg.com/globe.gl@2/dist/globe.gl.min.js"></script>
<script>
  const GLOBE_USERS_URL = '/api/globe-users';
  const REFRESH_SEC = 30;
  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let globe, isRotating = true;
  let countdownTimer, countdown = REFRESH_SEC;

  function flag(iso) {
    if (!iso || iso.length !== 2) return '🌐';
    try { return String.fromCodePoint(...[...iso.toUpperCase()].map(c => 0x1F1A5 + c.charCodeAt(0))); }
    catch { return '🌐'; }
  }

  function deviceBadge(name) {
    const n = (name || '').toLowerCase();
    if (n === 'mobile') return '<span class="pl-row-badge badge-mobile">Mobile</span>';
    if (n === 'tablet') return '<span class="pl-row-badge badge-tablet">Tablet</span>';
    return '<span class="pl-row-badge badge-desktop">Desktop</span>';
  }

  function srcIcon(name) {
    const icons = {
      google: 'G', bing: 'B', facebook: 'F', twitter: 'X', x: 'X',
      instagram: 'I', youtube: 'Y', direct: '→', reddit: 'R'
    };
    const letter = icons[(name || '').toLowerCase()] || (name || '?').charAt(0).toUpperCase();
    return `<div class="pl-row-icon" style="font-size:10px;font-weight:700">${letter}</div>`;
  }

  function makeAvatarEl(user) {
    const sz = Math.min(26 + user.count * 4, 46);
    const color = user.color || '#22c374';
    const seed = encodeURIComponent(user.city + user.countryId);
    const el = document.createElement('div');
    el.className = 'globe-avatar';
    el.style.cssText = `width:${sz}px;height:${sz}px;color:${color}`;
    el.title = `${user.city}, ${user.country} — ${user.count} user${user.count !== 1 ? 's' : ''}`;
    el.innerHTML = `
    <div class="globe-avatar-dot" style="width:${sz}px;height:${sz}px;background:${color}">
      <img src="https://api.dicebear.com/9.x/pixel-art/svg?seed=${seed}&size=${sz}"
           width="${sz}" height="${sz}" style="border-radius:50%;display:block"
           onerror="this.style.display='none'">
    </div>
    <div class="globe-avatar-ring"></div>
    ${user.count > 1 ? `<div class="globe-avatar-count">${user.count}</div>` : ''}
  `;

    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const popup = document.getElementById('avatarPopup');
      const rect = el.getBoundingClientRect();
      // Position popup: prefer right side, flip left if too close to edge
      let left = rect.right + 8;
      if (left + 218 > window.innerWidth) left = rect.left - 226;
      let top = rect.top - 20;
      if (top + 180 > window.innerHeight) top = window.innerHeight - 185;
      popup.style.left = Math.max(8, left) + 'px';
      popup.style.top = Math.max(8, top) + 'px';
      document.getElementById('apImg').src = `https://api.dicebear.com/9.x/pixel-art/svg?seed=${seed}&size=38`;
      document.getElementById('apCity').textContent = user.city || 'Unknown City';
      document.getElementById('apCountry').textContent = `${flag(user.countryId)} ${user.country || ''}`;
      document.getElementById('apDevice').textContent = user.device || 'Desktop';
      document.getElementById('apProp').textContent = user.prop || '—';
      document.getElementById('apCount').textContent = `${user.count} active`;
      popup.classList.add('show');
    });

    return el;
  }

  function updatePanels(json) {
    const users = json.users || [];
    const cities = json.cities || [];
    const countries = json.countries || [];
    const devices = json.devices || [];
    const properties = json.properties || [];
    window._globeProperties = properties; // save for filter

    const rawTotal = json.totalActiveUsers ?? users.reduce((s, u) => s + u.count, 0);
    document.getElementById('glTotalUsers').textContent = rawTotal.toLocaleString();

    document.getElementById('referrerList').innerHTML = cities.length
      ? cities.slice(0, 7).map(c =>
        `<div class="pl-row"><span class="pl-row-icon" style="font-size:13px;background:none">${flag(c.id)}</span><span class="pl-row-name">${c.city}</span><span class="pl-row-count">${c.count}</span></div>`
      ).join('')
      : '<div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">No data</span></div>';

    document.getElementById('countryList').innerHTML = countries.length
      ? countries.slice(0, 7).map(c =>
        `<div class="pl-row"><span class="pl-row-icon" style="font-size:13px;background:none">${flag(c.id)}</span><span class="pl-row-name">${c.name}</span><span class="pl-row-count">${c.count}</span></div>`
      ).join('')
      : '<div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">No data</span></div>';

    document.getElementById('deviceList').innerHTML = devices.length
      ? devices.map(d =>
        `<div class="pl-row">${deviceBadge(d.name)}<span class="pl-row-name">${d.name}</span><span class="pl-row-count">${d.count}</span></div>`
      ).join('')
      : '<div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">No data</span></div>';

    renderPropertiesList(properties, '');
  }

  function updateFeed(json) {
    const users = json.users || [];
    const feedEl = document.getElementById('feedList');
    if (!users.length) {
      feedEl.innerHTML = '<div class="feed-item" style="opacity:.4"><span style="color:var(--g-muted)">No active visitors right now.</span></div>';
      return;
    }
    feedEl.innerHTML = users.slice(0, 4).map((u, i) => `
    <div class="feed-item" style="animation-delay:${i * 60}ms">
      <div class="feed-avatar" style="background:${u.color}">${(u.city || '?').charAt(0).toUpperCase()}</div>
      <span class="feed-flag">${flag(u.countryId)}</span>
      <span class="feed-city">${u.city}</span>
      <span class="feed-via">via</span>
      <span style="font-size:11px;color:var(--g-muted)">${u.device || 'Desktop'}</span>
      <span class="feed-count">×${u.count}</span>
    </div>
  `).join('');
  }

  function renderGlobe(json) {
    if (!globe) return;
    const users = (json.users || []).filter(u => u.lat != null && u.lng != null);
    globe
      .htmlElementsData(users)
      .htmlLat('lat')
      .htmlLng('lng')
      .htmlAltitude(0.01)
      .htmlElement(d => makeAvatarEl(d));
  }

  function renderPropertiesList(properties, query) {
    const q = (query || '').toLowerCase();
    const rows = properties.filter(p => !q || p.site.toLowerCase().includes(q) || (p.domain || '').includes(q));
    const max = rows.length ? Math.max(...rows.map(r => r.count)) : 1;
    document.getElementById('propertiesList').innerHTML = rows.length
      ? rows.map(p => `
        <div class="pl-row" style="flex-direction:column;align-items:flex-start;gap:1px;padding:5px 0;border-bottom:1px solid var(--g-border)">
          <div style="display:flex;align-items:center;gap:6px;width:100%">
            <span class="pl-row-name" style="font-size:11px;font-weight:600">${p.site}</span>
            <span class="pl-row-count">${p.count}</span>
          </div>
          ${p.domain ? `<div style="font-size:9px;color:var(--g-muted);margin-bottom:2px">${p.domain}</div>` : ''}
          <div class="pl-prop-bar" style="width:${Math.round((p.count / max) * 100)}%"></div>
        </div>`).join('')
      : '<div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">No matching properties</span></div>';
  }

  async function fetchAndRender() {
    try {
      const res = await fetch(GLOBE_USERS_URL);
      const json = await res.json();
      renderGlobe(json);
      updatePanels(json);
      updateFeed(json);
      document.getElementById('glFetchedAt').textContent =
        new Date(json.fetchedAt || Date.now()).toLocaleTimeString();
    } catch (err) { console.error('[globe]', err); }
  }

  async function initGlobe() {
    const navH = document.querySelector('nav')?.offsetHeight ?? 64;
    document.getElementById('panel-left').style.top = (navH + 12) + 'px';
    document.getElementById('panel-controls').style.top = (navH + 12) + 'px';

    globe = Globe({ animateIn: false })
      .globeImageUrl('//unpkg.com/three-globe/example/img/earth-dark.jpg')
      .backgroundImageUrl('//unpkg.com/three-globe/example/img/night-sky.png')
      .atmosphereColor('#1a3dff')
      .atmosphereAltitude(0.14)
      .enablePointerInteraction(true)
      (document.getElementById('globe-canvas'));

    const resize = () => { globe.width(window.innerWidth); globe.height(window.innerHeight); };
    resize();
    window.addEventListener('resize', resize);

    if (!REDUCED_MOTION) {
      globe.controls().autoRotate = true;
      globe.controls().autoRotateSpeed = 0.3;
    }

    const loadEl = document.getElementById('globe-loading');
    loadEl.style.opacity = '0';
    setTimeout(() => loadEl.remove(), 700);

    await fetchAndRender();
    startCountdown();
  }

  function startCountdown() {
    clearInterval(countdownTimer);
    countdown = REFRESH_SEC;
    const el = document.getElementById('glCountdown');
    el.textContent = countdown + 's';
    countdownTimer = setInterval(async () => {
      countdown--;
      el.textContent = countdown + 's';
      if (countdown <= 0) { countdown = REFRESH_SEC; await fetchAndRender(); }
    }, 1000);
  }

  document.getElementById('btnRotate').addEventListener('click', () => {
    isRotating = !isRotating;
    if (globe) globe.controls().autoRotate = isRotating && !REDUCED_MOTION;
    document.getElementById('btnRotate').classList.toggle('active', isRotating);
  });

  document.getElementById('btnBlur').addEventListener('click', () => {
    const on = document.body.classList.toggle('privacy-blur');
    document.getElementById('btnBlur').classList.toggle('active', on);
  });

  document.getElementById('btnRefresh').addEventListener('click', async () => {
    const icon = document.getElementById('refreshGlobeIcon');
    icon.style.animation = 'spin 700ms linear infinite';
    countdown = REFRESH_SEC;
    await fetchAndRender();
    icon.style.animation = '';
    startCountdown();
  });

  // Avatar popup: close on X button or click outside
  document.getElementById('apClose').addEventListener('click', () => {
    document.getElementById('avatarPopup').classList.remove('show');
  });
  document.addEventListener('click', (e) => {
    const popup = document.getElementById('avatarPopup');
    if (popup.classList.contains('show') && !popup.contains(e.target)) {
      popup.classList.remove('show');
    }
  });

  // Properties filter
  document.getElementById('propFilter').addEventListener('input', (e) => {
    renderPropertiesList(window._globeProperties || [], e.target.value);
  });

  initGlobe();
</script>