<link rel="stylesheet" href="/css/panel.css" />
<style>
  /* Map-only tokens (DESIGN.md exception, like the dither fill). Plain values, not light-dark(): the canvas engine reads them with getComputedStyle. */
  :root { --sea: #e4e5ec; --land: #ffffff; --landline: #d4d4dc; --grat: rgba(24,24,27,.05); --space: #f7f7f9; --halo: rgba(79,70,229,.16); --indline: #a8a8b4; }
  :root[data-theme="dark"] { --sea: #0f0f13; --land: #1d1d23; --landline: #33333c; --grat: rgba(255,255,255,.04); --space: #060608; --halo: rgba(129,140,248,.22); --indline: #5a5a66; }
  :root[data-map="outdoors"] { --sea: #4a9fd8; --land: #9cd08a; --landline: #6f9f5f; --grat: rgba(30,80,110,.08); --space: #eef4f7; --halo: rgba(70,150,200,.35); --indline: #7d7488; }
  :root[data-theme="dark"][data-map="outdoors"] { --sea: #0b3a5e; --land: #24502f; --landline: #3a6d47; --grat: rgba(160,210,240,.05); --space: #04080b; --halo: rgba(90,170,230,.25); --indline: #7d7488; }

  /* Vivid looks (MapLibre globe, Outdoors): dark space backdrop and a stronger blue halo in both themes */
  :root[data-gspace="dark"] { --space: #05070d; --halo: rgba(74,159,216,.55); }

  body { overflow: hidden; }
  #appFooter, .dash-foot, body > .hidden { display: none !important; }
  .container.mx-auto.p-5.mb-auto { padding: 0 !important; margin: 0 !important; max-width: 100% !important; }

  .gstage { position: fixed; inset: 52px 0 0 0; background: var(--space); overflow: clip; touch-action: none; font: 400 14px/1.5 var(--font); color: var(--text); }
  .gstage * { box-sizing: border-box; }
  .gstage .num { font-variant-numeric: tabular-nums; }
  .gstage :focus-visible { outline: 2px solid var(--accent-fg); outline-offset: 2px; }
  .gmap, .gmap > * { position: absolute; inset: 0; }
  .gmap canvas { width: 100%; height: 100%; cursor: grab; }
  .gmap .maplibregl-canvas { outline: none; }
  .attr { position: absolute; left: 12px; bottom: 8px; z-index: 2; font-size: 10.5px; color: var(--text-3); background: var(--surface); padding: 1px 6px; border-radius: var(--r); }
  .attr a { color: inherit; }
  .marks { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .gpop { position: absolute; z-index: 2; background: var(--surface); border: 1px solid var(--border-2); border-radius: var(--r-lg); box-shadow: var(--pop-shadow); }

  /* Summary panel */
  .gsum { top: 12px; left: 12px; width: min(340px, calc(100% - 24px)); padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 10px; max-height: calc(100% - 24px); overflow: auto; }
  .tools { display: flex; gap: 2px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .ib { width: 28px; height: 28px; display: grid; place-items: center; border: 0; border-radius: var(--r); background: transparent; color: var(--text-2); cursor: pointer; padding: 0; transition: background-color .15s, color .15s; }
  .ib:hover { background: var(--surface-2); color: var(--text); }
  .ib[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent-fg); }
  .ib svg, .gico svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .ghead { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .ghead b { font-size: 28px; font-weight: 600; letter-spacing: -.02em; line-height: 1; }
  .ghead > span { color: var(--text-2); font-size: 13px; }
  .ghead .key { color: var(--good); }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--good); display: inline-block; animation: gpulse 2s ease-out infinite; }
  @keyframes gpulse { 0% { opacity: 1; } 70% { opacity: .35; } 100% { opacity: 1; } }
  .grow { display: flex; flex-direction: column; gap: 4px; }
  .grow h3 { font-size: 12px; font-weight: 500; color: var(--text-3); margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; max-height: 52px; overflow: hidden; }
  .chip { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 8px; border: 1px solid var(--border-2); border-radius: var(--r); background: var(--surface); font-size: 12px; color: var(--text); white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
  .chip .k { color: var(--text-3); font-size: 11px; font-weight: 500; }
  .chip .v { font-weight: 600; }
  .rf { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; border-top: 1px solid var(--border); padding-top: 8px; font-size: 12px; color: var(--text-3); }
  .rf select { height: 26px; border: 1px solid var(--border-2); border-radius: var(--r); background: var(--surface); color: var(--text); font: 500 12px var(--font); padding: 0 4px; }
  .rf .cap { flex-basis: 100%; }
  .rf .warn { color: var(--warn); }
  .lw { display: inline-flex; align-items: center; gap: 6px; margin-left: auto; cursor: pointer; color: var(--text-2); }
  .lw input { accent-color: var(--accent); margin: 0; }

  /* Event feed */
  .gbr { position: absolute; right: 12px; bottom: 12px; z-index: 2; width: min(420px, calc(100% - 24px)); display: flex; flex-direction: column; align-items: flex-end; gap: 8px; pointer-events: none; }
  .gbr > * { pointer-events: auto; }
  .gbr .gfeed { position: static; width: 100%; }
  .gfeed { max-height: 212px; display: flex; flex-direction: column; }

  /* Zoom control: DESIGN.md .btn (surface, border-2 stroke, 2px radius, 32px), stacked */
  .gzoom { display: flex; flex-direction: column; }
  .zb { width: 32px; height: 32px; display: grid; place-items: center; padding: 0; border: 1px solid var(--border-2); border-radius: var(--r); background: var(--surface); color: var(--text); cursor: pointer; transition: background-color .15s, transform .12s var(--ease-out); }
  .zb:first-child { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .zb:last-child { border-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; }
  .zb:hover { background: var(--surface-2); }
  .zb:active { transform: scale(.97); }
  .zb:disabled { opacity: .5; pointer-events: none; }
  .zb svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }

  /* Collapsible summary panel: toolbar + live count only */
  .gmin { margin-left: auto; }
  .gmin svg { transition: transform .15s var(--ease-out); }
  .gsum[data-min] .gmin svg { transform: rotate(180deg); }
  .gsum[data-min] > :not(.tools):not(.ghead) { display: none; }
  .gnote { margin: 0; font-size: 11.5px; color: var(--text-3); }
  .gfeed[hidden] { display: none; }
  .feed-h { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--border); font-size: 12px; color: var(--text-3); }
  .feed-h b { color: var(--text); font-weight: 600; font-size: 13px; }
  .feed-h button { border: 0; background: none; color: var(--accent-fg); font: 500 12px var(--font); cursor: pointer; padding: 0; }
  .gfeed ul { list-style: none; margin: 0; padding: 4px 0; overflow: auto; }
  .gfeed li { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 8px; align-items: start; padding: 5px 12px; font-size: 12.5px; line-height: 1.4; }
  .gfeed li.empty { display: block; color: var(--text-3); }
  .gfeed li .t { color: var(--text-3); font-size: 11px; white-space: nowrap; }
  .gfeed li em { font-style: normal; color: var(--text-2); }
  .gfeed li .key { color: var(--good); font-weight: 500; }
  .gfeed li.new { animation: gin .18s var(--ease-out); }
  @keyframes gin { from { opacity: 0; transform: translateY(-4px); } }
  .av { width: 22px; height: 22px; border-radius: 50%; background: var(--surface-3); overflow: hidden; display: grid; place-items: center; font-size: 10px; font-weight: 600; color: var(--text-2); flex: none; }
  .av img { width: 100%; height: 100%; display: block; }

  /* Avatar markers */
  .mk { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); pointer-events: auto; cursor: pointer; padding: 0; width: var(--s); height: var(--s); border-radius: 50%; background: var(--surface); border: 2px solid #fff; box-shadow: 0 1px 3px rgba(0,0,0,.35); transition: transform .15s var(--ease-out); display: grid; place-items: center; font: 600 10px var(--font); color: var(--text-2); }
  .mk:hover, .mk.sel { z-index: 999 !important; transform: translate(-50%, -50%) scale(1.15); }
  .mk.sel { border-color: var(--accent); }
  .mk img { width: 100%; height: 100%; border-radius: 50%; display: block; }
  .mk.grp { background: none; border: 0; box-shadow: none; width: calc(var(--s) + var(--n) * 11px); }
  .mk.grp .f { position: absolute; top: 0; left: var(--o); width: var(--s); height: var(--s); border-radius: 50%; overflow: hidden; background: var(--surface); border: 2px solid #fff; box-shadow: 0 1px 3px rgba(0,0,0,.35); display: grid; place-items: center; }
  .mk.grp.sel .f:first-child { border-color: var(--accent); }
  #gmarks .mk { animation: gfade .12s linear; }
  @keyframes gfade { from { opacity: 0; } }
  .mk:focus-visible { outline: 2px solid var(--accent-fg); outline-offset: 2px; }

  /* Card shell (shared by the city card and the group list) */
  .gcard { z-index: 3; width: 280px; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
  .gcard[hidden] { display: none; }
  .gcard .x { position: absolute; right: 6px; top: 6px; }
  .gcard-t { display: flex; gap: 10px; align-items: center; padding-right: 24px; }
  .gcard-t .av { width: 36px; height: 36px; }
  .gcard-t b { font-size: 15px; font-weight: 600; display: block; }
  .gcard-t > div > span { font-size: 12px; color: var(--text-3); }

  /* Group list card */
  .glist { list-style: none; margin: 0; padding: 0; max-height: 240px; overflow-y: auto; }
  .glist button { width: 100%; display: flex; align-items: center; gap: 8px; padding: 6px 4px; border: 0; background: none; color: var(--text); font: inherit; text-align: left; cursor: pointer; border-radius: var(--r); }
  .glist button:hover { background: var(--surface-2); }
  .glist button > span:nth-child(2) { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* City card body (variant A, stacked faces): renderCityCard() in globe.js. Swap this block and that function together. */
  .gcard.city { width: 300px; padding: 0; gap: 0; }
  .gcity .ch { display: flex; align-items: center; gap: 10px; padding: 12px 36px 12px 12px; }
  .gcity .flag { width: 24px; height: 16px; border-radius: 2px; flex: none; box-shadow: 0 0 0 1px var(--border-2); display: block; object-fit: cover; }
  .gcity .ct { flex: 1; min-width: 0; }
  .gcity .ct b { display: block; font-size: 14px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gcity .ct span { display: block; font-size: 12px; color: var(--text-3); }
  .gcity .stack { display: flex; align-items: center; }
  .gcity .stack .fav + .fav { margin-left: -6px; }
  .gcity .stack .more { margin-left: 4px; font-size: 12px; color: var(--text-3); }
  .gcity .cb { border-top: 1px solid var(--border); padding: 12px; display: grid; gap: 10px; }
  .gcity .kv { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .gcity .kv div { display: grid; }
  .gcity .kv small { font-size: 12px; color: var(--text-3); }
  .gcity .kv b { font-weight: 600; }
  .gcity .page { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 12px; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gcity .tw { max-height: 190px; overflow-y: auto; scrollbar-width: thin; scrollbar-gutter: stable; }
  .gcity .tbl th:last-child, .gcity .tbl td:last-child { padding-right: 4px; }
  .gcity .tbl { width: 100%; border-collapse: collapse; font-size: 12px; table-layout: fixed; }
  .gcity .tbl th { font-weight: 500; color: var(--text-3); text-align: right; padding: 4px 0; position: sticky; top: 0; background: var(--surface); width: 52px; }
  .gcity .tbl th:first-child { width: auto; }
  .gcity .tbl th:first-child, .gcity .tbl td:first-child { text-align: left; }
  .gcity .tbl td { padding: 6px 0; border-top: 1px solid var(--border); text-align: right; }
  .gcity .site { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .gcity .site > span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gcity .foot { font-size: 12px; color: var(--text-3); }

  /* Site faces: favicon or letter tile */
  .fav { width: 20px; height: 20px; border-radius: 2px; flex: none; display: grid; place-items: center; font-size: 11px; font-weight: 700; color: #fff; background: #fff; object-fit: contain; box-shadow: 0 0 0 2px var(--surface); }
  .chip .fav { width: 14px; height: 14px; font-size: 9px; box-shadow: none; }
  .gstage[data-av="sites"] .mk:not(.grp), .gstage[data-av="sites"] .mk.grp .f { background: #fff; }
  .mk .fav { width: 62%; height: 62%; border-radius: 2px; box-shadow: none; }
  .mk .fav.tile { width: 100%; height: 100%; border-radius: 50%; font-size: 12px; }

  .gerr { position: absolute; inset: 0; display: grid; place-items: center; color: var(--text-3); font-size: 13px; }

  body.privacy-blur .gstage [data-privacy] { filter: blur(6px); user-select: none; }

  @media (max-width: 860px) {
    .gsum { gap: 8px; }
    .gsum .grow:nth-of-type(n+2), .rf .cap { display: none; }
    .chips { max-height: 24px; }
    .gbr { left: 0; right: 0; bottom: 0; width: 100%; align-items: flex-start; }
    .gzoom { margin-left: 12px; }
    .gfeed { max-height: 150px; border-radius: var(--r-lg) var(--r-lg) 0 0; }
    .gbr:has(.gfeed[hidden]) { bottom: 12px; }
    .gcard { left: 0 !important; right: 0; bottom: 0; top: auto !important; width: 100%; border-radius: var(--r-lg) var(--r-lg) 0 0; padding-bottom: calc(12px + env(safe-area-inset-bottom)); }
    .gcard.city { width: 100%; padding: 0 0 env(safe-area-inset-bottom); }
    .attr { left: auto; right: 8px; bottom: auto; top: 8px; }
  }
  @media (hover: none), (pointer: coarse) {
    .ib { width: 40px; height: 40px; }
    .rf select { height: 36px; }
    .zb { width: 44px; height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gstage *, .gstage *::before, .gstage *::after { animation: none !important; transition: none !important; }
  }
</style>

<div id="gstage" class="gstage">
  <div class="gmap" id="gmap" role="img" aria-label="Map of live visitors"></div>
  <div class="attr" id="gattr" hidden>&copy; <a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a></div>
  <div class="marks" id="gmarks"></div>

  <section class="gpop gsum" aria-label="Live summary">
    <div class="tools" role="toolbar" aria-label="Map controls">
      <button type="button" class="ib" data-t="proj" data-icon="map" aria-pressed="false" title="Switch to 2D map" aria-label="Switch to 2D map"></button>
      <button type="button" class="ib" data-t="style" data-icon="leaf" aria-pressed="false" title="Map style: Minimal (switch to Outdoors)" aria-label="Map style"></button>
      <button type="button" class="ib" data-t="theme" data-icon="sun" title="Light or dark map" aria-label="Light or dark map"></button>
      <button type="button" class="ib" data-t="feed" data-icon="list" aria-pressed="true" title="Show event feed (M)" aria-label="Show event feed (M)"></button>
      <button type="button" class="ib" id="privacyBtn" data-icon="eyeoff" aria-pressed="false" title="Hide names and domains (P)" aria-label="Hide names and domains"></button>
      <button type="button" class="ib" data-t="refresh" data-icon="refresh" title="Refresh now" aria-label="Refresh now"></button>
      <button type="button" class="ib" data-t="full" data-icon="full" title="Fullscreen" aria-label="Fullscreen"></button>
      <button type="button" class="ib gmin" data-t="panel" data-icon="chev" aria-expanded="true" title="Collapse panel" aria-label="Collapse panel"></button>
    </div>
    <div class="ghead"><span class="live-dot" aria-hidden="true"></span><b class="num" id="gTotal">0</b><span id="gSub">Loading live visitors</span></div>
    <div id="gRows"></div>
    <div class="rf">
      <label for="rfSel">Refresh</label>
      <select id="rfSel">
        <option value="auto">Auto</option>
        <option value="30">30 s</option>
        <option value="60">1 min</option>
        <option value="120">2 min</option>
        <option value="300">5 min</option>
      </select>
      <span class="num" id="rfNext"></span>
      <label for="avSel">Avatars</label>
      <select id="avSel">
        <option value="people">People</option>
        <option value="sites">Sites</option>
      </select>
      <label class="lw"><input type="checkbox" id="gLight" /> Lightweight map</label>
      <span class="cap" id="rfCap"></span>
    </div>
    <p class="gnote" id="gNote">Avatar = city. Stack = nearby cities, click to zoom.</p>
  </section>

  <div class="gbr">
    <div class="gzoom" role="group" aria-label="Zoom">
      <button type="button" class="zb" data-t="zin" data-icon="plus" title="Zoom in" aria-label="Zoom in"></button>
      <button type="button" class="zb" data-t="zout" data-icon="minus" title="Zoom out" aria-label="Zoom out"></button>
    </div>
    <section class="gpop gfeed" id="gfeed" aria-label="Live events">
      <div class="feed-h" id="gfeedH"><b>Live events</b><span>Press M to hide</span></div>
      <ul id="gfeedList" aria-live="polite"></ul>
    </section>
  </div>

  <div class="gpop gcard" id="gcard" role="dialog" aria-label="City details" hidden></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>
<script src="/js/clusterMarks.js"></script>
<script src="/js/letterTile.js"></script>
<script src="/js/globe.js"></script>
