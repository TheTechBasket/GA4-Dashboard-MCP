<style>
  /* ─── Globe Design Tokens (Zed / DESIGN.md Specification) ─── */
  :root {
    --g-bg: #e5e7eb;
    --g-panel: rgba(255, 255, 255, 0.92);
    --g-card: rgba(244, 244, 242, 0.96);
    --g-border: #cccfd3;
    --g-text: #3a3d43;
    --g-muted: #5d636f;
    --g-accent: #1348dc;
    --g-signal: #2b7fff;
    --g-green: #059669;
    --g-mono: 'Zed Mono', 'JetBrains Mono', ui-monospace, monospace;
    --g-serif: 'Plex Serif', Georgia, serif;
    --g-sans: 'Inter', system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--g-bg) !important;
    color: var(--g-text);
    font-family: var(--g-sans);
    overflow: hidden;
    background-image: radial-gradient(#cccfd3 1px, transparent 1px) !important;
    background-size: 8px 8px !important;
  }

  /* Nav from the shared layout */
  nav { position: relative; z-index: 200; }

  /* Kill layout container padding so the globe fills the screen */
  .container.mx-auto.p-5.mb-auto {
    padding: 0 !important;
    margin: 0 !important;
    max-width: 100% !important;
  }

  /* Hide footer and debug responsive from main layout */
  #appFooter,
  .hidden,
  .dash-foot { display: none !important; }

  #globe-canvas {
    position: fixed;
    inset: 0;
    width: 100vw !important;
    height: 100vh !important;
  }

  /* Loading Overlay */
  #globe-loading {
    position: fixed; inset: 0; background: var(--g-bg);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    z-index: 300; gap: 16px; transition: opacity 500ms ease;
  }
  .gl-spinner {
    width: 40px; height: 40px;
    border: 2px solid var(--g-border); border-top-color: var(--g-signal);
    border-radius: 50%; animation: spin 800ms linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .gl-load-text { font-family: var(--g-mono); font-size: 11px; letter-spacing: 0.1em; color: var(--g-muted); }

  /* Top Control & HUD Header */
  .globe-hud-bar {
    position: fixed; top: 76px; left: 24px; right: 24px;
    display: flex; align-items: center; justify-content: space-between;
    z-index: 100; pointer-events: none;
  }

  .hud-title-box {
    background: var(--g-panel); border: 1px solid var(--g-border);
    border-radius: 2px; padding: 12px 18px; pointer-events: auto;
    box-shadow: rgba(111, 123, 144, 0.1) 0 -2px 0 0 inset;
  }
  .hud-title { font-family: var(--g-serif); font-size: 20px; font-weight: 340; color: var(--g-accent); letter-spacing: -0.02em; }
  .hud-sub { font-family: var(--g-mono); font-size: 10px; color: var(--g-muted); margin-top: 2px; letter-spacing: 0.05em; }

  /* Left Sidebar — Live Rankings & Control Panel */
  #panel-left {
    position: fixed; left: 24px; top: 156px; width: 280px;
    background: var(--g-panel); border: 1px solid var(--g-border);
    border-radius: 2px;
    overflow: hidden; z-index: 100; max-height: calc(100vh - 270px); overflow-y: auto;
    box-shadow: rgba(111, 123, 144, 0.1) 0 -2px 0 0 inset;
  }
  #panel-left::-webkit-scrollbar { width: 3px; }
  #panel-left::-webkit-scrollbar-thumb { background: var(--g-border); border-radius: 2px; }

  .pl-header {
    padding: 16px 18px; border-bottom: 1px solid var(--g-border);
    display: flex; align-items: center; justify-content: space-between;
  }
  .pl-total-wrap { display: flex; align-items: baseline; gap: 10px; }
  .pl-live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--g-green); animation: pulse-dot 1.8s ease-in-out infinite; }
  @keyframes pulse-dot { 0%,100% { box-shadow: 0 0 0 0 rgba(5,150,105,.4); } 50% { box-shadow: 0 0 0 6px rgba(5,150,105,0); } }
  .pl-total { font-family: var(--g-mono); font-size: 32px; font-weight: 700; color: var(--g-accent); letter-spacing: -0.02em; }
  .pl-total-label { font-family: var(--g-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--g-muted); }

  .pl-section { padding: 12px 18px; border-bottom: 1px solid var(--g-border); }
  .pl-section:last-child { border-bottom: none; }
  .pl-section-title { font-family: var(--g-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--g-muted); margin-bottom: 8px; }

  .pl-row {
    display: flex; align-items: center; gap: 10px; padding: 5px 6px; border-radius: 2px;
    font-size: 12px; color: var(--g-text); cursor: pointer; transition: background 150ms ease;
  }
  .pl-row:hover { background: #e6effe; }
  .pl-row-icon { font-size: 14px; flex-shrink: 0; }
  .pl-row-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .pl-row-count { font-family: var(--g-mono); font-size: 11px; color: var(--g-green); font-weight: 700; flex-shrink: 0; }
  .pl-row-bar { height: 2px; background: var(--g-signal); border-radius: 1px; transition: width 300ms ease; margin-top: 3px; }

  /* Right floating controls */
  #panel-controls {
    position: fixed; right: 24px; top: 156px; display: flex; flex-direction: column; gap: 8px; z-index: 100;
  }
  .ctrl-btn {
    width: 40px; height: 40px; border-radius: 2px;
    background: var(--g-panel); border: 1px solid var(--g-border);
    color: var(--g-muted); display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all 150ms ease; font-family: var(--g-mono); font-size: 11px;
  }
  .ctrl-btn:hover { color: var(--g-accent); border-color: var(--g-signal); background: var(--g-card); }
  .ctrl-btn.active { color: var(--g-accent); border-color: var(--g-signal); background: #e6effe; }

  /* Bottom Live Feed Stream Ticker */
  #panel-feed {
    position: fixed; bottom: 20px; left: 320px; right: 24px;
    background: var(--g-panel); border: 1px solid var(--g-border); border-radius: 2px;
    z-index: 100; padding: 10px 12px; min-height: 52px; max-height: 72px; overflow: hidden;
    box-shadow: rgba(111, 123, 144, 0.1) 0 -2px 0 0 inset;
  }
  .feed-header { font-family: var(--g-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--g-muted); margin-bottom: 6px; }
  .feed-list { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 4px; }
  .feed-list::-webkit-scrollbar { height: 3px; }
  .feed-list::-webkit-scrollbar-thumb { background: var(--g-border); border-radius: 2px; }

  .feed-card {
    background: var(--g-card); border: 1px solid var(--g-border);
    border-radius: 2px; padding: 6px 12px; display: flex; align-items: center; gap: 10px;
    flex-shrink: 0; font-size: 11px; white-space: nowrap;
  }
  .feed-flag { font-size: 14px; }
  .feed-city { font-weight: 600; color: var(--g-text); }
  .feed-prop { color: var(--g-muted); font-size: 10px; }
  .feed-badge { font-family: var(--g-mono); font-size: 10px; background: #e6effe; color: var(--g-accent); padding: 1px 6px; border-radius: 2px; }

  /* Interactive Markers */
  .globe-marker { position: relative; cursor: pointer; }
  .globe-marker-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--g-signal); border: 2px solid #ffffff; box-shadow: 0 0 8px rgba(43,127,255,.35); }
  .globe-marker-ring { position: absolute; inset: -6px; border-radius: 50%; border: 1.5px solid var(--g-signal); opacity: 0.6; animation: markerRing 2s ease-out infinite; }
  @keyframes markerRing { 0% { transform: scale(1); opacity: 0.6; } 100% { transform: scale(2.2); opacity: 0; } }

  /* Privacy blur rules for URLs, domains, and properties */
  body.privacy-blur .pl-row-name,
  body.privacy-blur .feed-city,
  body.privacy-blur .feed-prop,
  body.privacy-blur [data-privacy],
  body.privacy-blur [data-domain] {
    filter: blur(8px) !important;
    user-select: none !important;
    pointer-events: none !important;
    opacity: 0.35 !important;
  }
  body.privacy-blur .pl-row-name:hover,
  body.privacy-blur .feed-city:hover {
    filter: blur(8px) !important;
  }

  @media (max-width: 820px) {
    .globe-hud-bar { top: 64px; left: 12px; right: 12px; }
    #panel-left {
      left: 12px; right: 12px; top: auto; bottom: 118px; width: auto;
      max-height: 38vh;
    }
    #panel-controls { right: 12px; top: 128px; }
    #panel-feed { left: 12px; right: 12px; bottom: 12px; max-height: 72px; }
    .hud-title { font-size: 17px; }
  }
</style>

<div id="globe-loading">
  <div class="gl-spinner"></div>
  <p class="gl-load-text">INITIALIZING 3D GLOBE ENGINE…</p>
</div>

<div id="globe-canvas"></div>

<!-- HUD Header -->
<div class="globe-hud-bar">
  <div class="hud-title-box">
    <div class="hud-title">Live Visitor Globe</div>
    <div class="hud-sub">REAL-TIME ACTIVE USER LOCATIONS</div>
  </div>
</div>

<!-- Left Leaderboard & Stats Panel -->
<div id="panel-left">
  <div class="pl-header">
    <div class="pl-total-wrap">
      <div class="pl-live-dot"></div>
      <div class="pl-total" id="glTotalUsers">0</div>
    </div>
    <div class="pl-total-label">Active Users</div>
  </div>

  <div class="pl-section">
    <div class="pl-section-title">Top Active Cities (Click to Fly)</div>
    <div id="cityList"><div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">Loading…</span></div></div>
  </div>

  <div class="pl-section">
    <div class="pl-section-title">Top Active Countries</div>
    <div id="countryList"><div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">Loading…</span></div></div>
  </div>

  <div class="pl-section">
    <div class="pl-section-title">Device Breakdown</div>
    <div id="deviceList"><div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">Loading…</span></div></div>
  </div>
</div>

<!-- Right Floating Controls -->
<div id="panel-controls">
  <button class="ctrl-btn" id="btnRotate" title="Toggle Auto-Rotation">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
  </button>
  <button class="ctrl-btn" id="btnReset" title="Reset Camera View">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
  </button>
  <button class="ctrl-btn" id="btnPrivacy" title="Toggle Privacy Mode">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
  </button>
</div>

<!-- Bottom Live Feed Stream Ticker -->
<div id="panel-feed">
  <div class="feed-header">Live visitor sample</div>
  <div class="feed-list" id="feedList">
    <div class="feed-card" style="opacity:0.6"><span>Listening for active visitor hits…</span></div>
  </div>
</div>

<script src="https://unpkg.com/globe.gl@2/dist/globe.gl.min.js"></script>
<script>
const GLOBE_USERS_URL = '/api/globe-users';
const REFRESH_INTERVAL_MS = 25000;

let globe = null;
let isRotating = false;

function escHtml(str) {
  return String(str ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function isPrivacyOn() {
  return document.body.classList.contains('privacy-blur');
}

function flagEmoji(iso) {
  if (!iso || iso.length !== 2) return '🌐';
  try { return String.fromCodePoint(...[...iso.toUpperCase()].map(c => 0x1F1A5 + c.charCodeAt(0))); }
  catch { return '🌐'; }
}

function createMarkerEl(user) {
  const el = document.createElement('div');
  el.className = 'globe-marker';
  el.title = isPrivacyOn()
    ? `${user.count} active visitors`
    : `${user.city}, ${user.country} (${user.count} active)`;
  el.innerHTML = `
    <div class="globe-marker-dot"></div>
    <div class="globe-marker-ring"></div>
  `;
  el.addEventListener('click', (e) => {
    e.stopPropagation();
    if (globe) {
      globe.pointOfView({ lat: user.lat, lng: user.lng, altitude: 1.4 }, 1200);
    }
  });
  return el;
}

function updateHUD(json) {
  const users = json.users || [];
  const cities = json.cities || [];
  const countries = json.countries || [];
  const devices = json.devices || [];

  const rawTotal = json.totalActiveUsers ?? users.reduce((s, u) => s + u.count, 0);
  document.getElementById('glTotalUsers').textContent = rawTotal.toLocaleString();

  // Top Cities list
  const cityEl = document.getElementById('cityList');
  if (cities.length) {
    const max = Math.max(1, ...cities.map(c => c.count));
    cityEl.innerHTML = cities.slice(0, 6).map(c => {
      const u = users.find(x => x.city === c.city);
      const lat = u ? u.lat : 20;
      const lng = u ? u.lng : 0;
      return `
        <div class="pl-row" onclick="flyToLoc(${lat}, ${lng})">
          <span class="pl-row-icon">${flagEmoji(c.id)}</span>
          <div style="flex:1;overflow:hidden">
            <div class="pl-row-name" data-privacy>${escHtml(c.city)}</div>
            <div class="pl-row-bar" style="width:${Math.round((c.count / max) * 100)}%"></div>
          </div>
          <span class="pl-row-count">${c.count}</span>
        </div>`;
    }).join('');
  } else {
    cityEl.innerHTML = '<div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">No active cities</span></div>';
  }

  // Countries list
  const countryEl = document.getElementById('countryList');
  if (countries.length) {
    const max = Math.max(1, ...countries.map(c => c.count));
    countryEl.innerHTML = countries.slice(0, 5).map(c => `
      <div class="pl-row">
        <span class="pl-row-icon">${flagEmoji(c.id)}</span>
        <div style="flex:1;overflow:hidden">
          <div class="pl-row-name" data-privacy>${escHtml(c.name)}</div>
          <div class="pl-row-bar" style="width:${Math.round((c.count / max) * 100)}%"></div>
        </div>
        <span class="pl-row-count">${c.count}</span>
      </div>`).join('');
  } else {
    countryEl.innerHTML = '<div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">No active countries</span></div>';
  }

  // Devices list
  const devEl = document.getElementById('deviceList');
  if (devices.length) {
    devEl.innerHTML = devices.map(d => `
      <div class="pl-row">
        <span class="pl-row-name">${escHtml(d.name)}</span>
        <span class="pl-row-count">${d.count}</span>
      </div>`).join('');
  } else {
    devEl.innerHTML = '<div class="pl-row"><span class="pl-row-name" style="color:var(--g-muted)">No data</span></div>';
  }

  // Live Stream Ticker
  const feedEl = document.getElementById('feedList');
  if (users.length) {
    feedEl.innerHTML = users.slice(0, 10).map(u => `
      <div class="feed-card">
        <span class="feed-flag">${flagEmoji(u.countryId)}</span>
        <span class="feed-city" data-privacy>${escHtml(u.city)}</span>
        <span class="feed-prop" data-privacy>${escHtml(u.prop || 'Active Site')}</span>
        <span class="feed-badge">${escHtml(u.device || 'Desktop')}</span>
      </div>`).join('');
  } else {
    feedEl.innerHTML = '<div class="feed-card" style="opacity:0.6"><span>No active visitors currently online</span></div>';
  }
}

function flyToLoc(lat, lng) {
  if (globe) {
    globe.pointOfView({ lat, lng, altitude: 1.3 }, 1200);
  }
}

function render3DGlobe(json) {
  if (!globe) return;
  const users = (json.users || []).filter(u => u.lat != null && u.lng != null);

  // Markers
  globe
    .htmlElementsData(users)
    .htmlLat('lat')
    .htmlLng('lng')
    .htmlAltitude(0.01)
    .htmlElement(d => createMarkerEl(d));

  globe.arcsData([]);

  // Ripple Rings
  globe
    .ringsData(users.slice(0, 6))
    .ringColor(() => '#2b7fff')
    .ringMaxRadius(3)
    .ringPropagationSpeed(1.6)
    .ringRepeatPeriod(1800);
}

async function fetchGlobeData() {
  try {
    const res = await fetch(GLOBE_USERS_URL);
    const json = await res.json();
    updateHUD(json);
    render3DGlobe(json);
  } catch (err) {
    console.warn('[globe] Failed to fetch globe data:', err);
  }
}

function initEngine() {
  const container = document.getElementById('globe-canvas');

  globe = Globe({ animateIn: false })
    .globeImageUrl('//unpkg.com/three-globe/example/img/earth-blue-marble.jpg')
    .backgroundColor('rgba(0,0,0,0)')
    .atmosphereColor('#1348dc')
    .atmosphereAltitude(0.14)
    .enablePointerInteraction(true)
    (container);

  const resize = () => {
    globe.width(window.innerWidth);
    globe.height(window.innerHeight);
  };
  resize();
  window.addEventListener('resize', resize);

  globe.controls().autoRotate = false;
  globe.controls().autoRotateSpeed = 0.35;

  const loadEl = document.getElementById('globe-loading');
  loadEl.style.opacity = '0';
  setTimeout(() => loadEl.remove(), 500);

  fetchGlobeData();
  setInterval(fetchGlobeData, REFRESH_INTERVAL_MS);
}

// Controls
document.getElementById('btnRotate').addEventListener('click', () => {
  isRotating = !isRotating;
  if (globe) globe.controls().autoRotate = isRotating;
  document.getElementById('btnRotate').classList.toggle('active', isRotating);
});

document.getElementById('btnReset').addEventListener('click', () => {
  if (globe) globe.pointOfView({ lat: 20, lng: 0, altitude: 2.2 }, 1000);
});

document.getElementById('btnPrivacy').addEventListener('click', () => {
  const on = document.body.classList.toggle('privacy-blur');
  document.getElementById('btnPrivacy').classList.toggle('active', on);
  localStorage.setItem('pb_privacy', on ? '1' : '0');
  fetchGlobeData();
});

window.addEventListener('load', () => {
  const savedPrivacy = localStorage.getItem('pb_privacy') === '1';
  document.body.classList.toggle('privacy-blur', savedPrivacy);
  document.getElementById('btnPrivacy').classList.toggle('active', savedPrivacy);
  initEngine();
});
</script>
