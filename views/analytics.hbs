<script>
    /* ─── Toast system ───────────────────────────────────────────────── */
    function toast(msg, icon) {
        const c = document.getElementById('toastContainer');
        if (!c) return;
        const el = document.createElement('div');
        el.className = 'toast-msg';
        el.innerHTML = (icon || '') + ' ' + msg;
        c.appendChild(el);
        setTimeout(() => {
            el.classList.add('out');
            setTimeout(() => el.remove(), 200);
        }, 2800);
    }

    /* ─── CSV Export helpers ──────────────────────────────────────────── */
    const cardDataStore = {}; // type → { rows, metricHeaders, ... }

    function exportCardCsv(type) {
        const data = cardDataStore[type];
        if (!data || !data.rows || !data.rows.length) {
            toast('No data to export');
            return;
        }
        const card = CARDS.find(c => c.type === type);
        const name = card ? card.title : type;
        const headers = ['Dimension', ...(data.metricHeaders || ['Value'])];
        const csvRows = [headers.join(',')];
        data.rows.forEach(r => {
            const dims = (r.dims || []).join(' / ').replace(/,/g, ' ');
            const vals = (r.metrics || []).map(v => v ?? 0);
            csvRows.push(['"' + dims + '"', ...vals].join(','));
        });
        downloadCsv(csvRows.join('\n'), name);
    }

    function exportAllCsv() {
        const allRows = ['Card,Dimension,Metric,Value'];
        CARDS.forEach(c => {
            const data = cardDataStore[c.type];
            if (!data || !data.rows) return;
            data.rows.forEach(r => {
                const dims = (r.dims || []).join(' / ').replace(/,/g, ' ');
                (r.metrics || []).forEach((v, mi) => {
                    const metric = (data.metricHeaders || [])[mi] || 'value';
                    allRows.push(['"' + c.title + '"', '"' + dims + '"', '"' + metric + '"', v ?? 0].join(','));
                });
            });
        });
        if (allRows.length <= 1) { toast('No data to export'); return; }
        downloadCsv(allRows.join('\n'), 'analytics-export');
        toast('&#10003; Exported ' + (allRows.length - 1) + ' rows');
    }

    function downloadCsv(content, name) {
        const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = (name || 'export').replace(/[^a-z0-9_-]/gi, '_') + '_' + currentRange + '.csv';
        a.click();
        URL.revokeObjectURL(url);
    }

    /* ─── Card definitions ───────────────────────────────────────────── */
    const CARDS = [
        {
            type: 'new-users-by-date', title: 'Growth Trend', wide: true, chartCard: true,
            sub: 'New users & sessions over time',
            color: '#10b981', bg: 'rgba(16,185,129,0.1)',
            icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
        },
        {
            type: 'traffic-sources', title: 'Traffic Sources', sub: 'Sessions by source / medium',
            color: '#e8562a', bg: 'rgba(232,86,42,0.1)',
            icon: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
        },
        {
            type: 'landing-pages', title: 'Landing Pages', sub: 'Sessions by entry page',
            color: '#3b82f6', bg: 'rgba(59,130,246,0.1)',
            icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
        },
        {
            type: 'countries', title: 'Countries', sub: 'Sessions by country',
            color: '#059669', bg: 'rgba(5,150,105,0.1)',
            icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
        },
        {
            type: 'events', title: 'Events', sub: 'Event count by name',
            color: '#f59e0b', bg: 'rgba(245,158,11,0.1)',
            icon: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
        },
        {
            type: 'browsers', title: 'Users by Browser', sub: 'New users in selected period',
            color: '#8b5cf6', bg: 'rgba(139,92,246,0.1)',
            icon: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
        },
        {
            type: 'page-paths', title: 'Top Pages', sub: 'Pageviews by path',
            color: '#06b6d4', bg: 'rgba(6,182,212,0.1)',
            icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
        },
        {
            type: 'devices', title: 'Devices', sub: 'Sessions by device type',
            color: '#ec4899', bg: 'rgba(236,72,153,0.1)',
            icon: '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
        },
        {
            type: 'revenue-by-date', title: 'Revenue Trend', wide: true, chartCard: true,
            sub: 'Purchase revenue & transactions over time',
            color: '#f59e0b', bg: 'rgba(245,158,11,0.1)',
            icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
        },
        {
            type: 'revenue-by-source', title: 'Revenue by Source', sub: 'Purchase revenue by traffic source',
            color: '#d97706', bg: 'rgba(217,119,6,0.1)',
            icon: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
        },
    ];

    let currentPropId = '';
    let currentRange = '28d';
    const RANGE_LABELS = { today: 'Today', '7d': 'Last 7 days', '28d': 'Last 28 days' };

    /* ─── Formatting ─────────────────────────────────────────────────── */
    function fmt(n, currency) {
        const v = Math.round((+n || 0) * 100) / 100;
        if (currency) return v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        if (v >= 1e6) return (v / 1e6).toFixed(1) + 'M';
        if (v >= 1e3) return (v / 1e3).toFixed(1) + 'k';
        return v.toLocaleString();
    }

    function skeleton() {
        return '<div class="an-skeleton">' + [100, 78, 60, 90, 55, 72].map(w =>
            '<div class="an-skel-row" style="width:' + w + '%"></div>').join('') + '</div>';
    }

    /* ─── SVG Trend chart ────────────────────────────────────────────── */
    function renderTrendChart(data, isCurrency) {
        const { rows, metricHeaders, type } = data;
        if (!rows || !rows.length) return '<div class="an-empty">No data for this period.</div>';

        const W = 900, H = 200, PAD = { t: 12, r: 12, b: 36, l: isCurrency ? 56 : 42 };
        const cW = W - PAD.l - PAD.r;
        const cH = H - PAD.t - PAD.b;
        const n = rows.length;

        const series = metricHeaders.map((_, mi) => rows.map(r => r.metrics[mi] || 0));
        const maxVal = Math.max(...series.flat(), 1);

        const COLORS = ['#10b981', '#e8562a', '#3b82f6', '#f59e0b'];

        function px(i) { return PAD.l + (n > 1 ? (i / (n - 1)) * cW : cW / 2); }
        function py(val) { return PAD.t + cH - (val / maxVal) * cH; }

        // Y grid + labels
        const yGrid = [0, 0.25, 0.5, 0.75, 1].map(f => {
            const v = Math.round(f * maxVal);
            const y = py(v);
            const lbl = isCurrency ? '$' + fmt(v, true) : fmt(v);
            return '<line x1="' + PAD.l + '" x2="' + (W - PAD.r) + '" y1="' + y + '" y2="' + y +
                '" stroke="currentColor" stroke-opacity=".07"/>' +
                '<text x="' + (PAD.l - 4) + '" y="' + (y + 4) + '" text-anchor="end" font-size="9" fill="currentColor" fill-opacity=".4">' + lbl + '</text>';
        }).join('');

        // X labels (evenly spaced)
        const step = Math.max(1, Math.floor(n / 6));
        const xLbls = rows.map((r, i) => {
            if (i !== 0 && i !== n - 1 && i % step !== 0) return '';
            const d = r.dims[0]; // YYYYMMDD
            return '<text x="' + px(i) + '" y="' + (H - 6) + '" text-anchor="middle" font-size="9" fill="currentColor" fill-opacity=".4">' +
                d.slice(4, 6) + '/' + d.slice(6, 8) + '</text>';
        }).join('');

        // Gradient defs + area + polyline per series
        const seriesSVG = series.map((vals, si) => {
            const pts = vals.map((v, i) => px(i) + ',' + py(v)).join(' ');
            const areaRest = px(n - 1) + ',' + (PAD.t + cH) + ' ' + PAD.l + ',' + (PAD.t + cH);
            const c = COLORS[si];
            return '<defs><linearGradient id="g' + si + type + '" x1="0" y1="0" x2="0" y2="1">' +
                '<stop offset="0%" stop-color="' + c + '" stop-opacity=".2"/>' +
                '<stop offset="100%" stop-color="' + c + '" stop-opacity="0"/>' +
                '</linearGradient></defs>' +
                '<polygon points="' + pts + ' ' + areaRest + '" fill="url(#g' + si + type + ')"/>' +
                '<polyline points="' + pts + '" fill="none" stroke="' + c + '" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>';
        }).join('');

        // Invisible hover targets on first series
        const hover = rows.map((r, i) => {
            const vals = series.map(s => s[i]);
            const d = r.dims[0];
            const date = d.slice(0, 4) + '-' + d.slice(4, 6) + '-' + d.slice(6, 8);
            const tip = date + '  ·  ' + metricHeaders.map((h, mi) =>
                h + ': ' + (isCurrency ? '$' + fmt(vals[mi], true) : fmt(vals[mi]))).join('  ·  ');
            return '<circle cx="' + px(i) + '" cy="' + py(vals[0]) + '" r="16" fill="transparent"' +
                ' data-tip="' + tip + '" class="chart-hp"/>';
        }).join('');

        const legend = metricHeaders.map((h, i) =>
            '<div class="an-chart-legend-item"><div class="an-chart-legend-dot" style="background:' + COLORS[i] + '"></div>' + h + '</div>'
        ).join('');

        return '<div class="an-chart-wrap">' +
            '<div class="an-chart-tooltip" id="ct-' + type + '"></div>' +
            '<svg class="an-chart-svg" viewBox="0 0 ' + W + ' ' + H + '">' +
            yGrid + xLbls + seriesSVG + hover + '</svg>' +
            '<div class="an-chart-legend">' + legend + '</div></div>';
    }

    /* ─── Bar rows ───────────────────────────────────────────────────── */
    function renderBarRows(data) {
        const { rows, metricHeaders } = data;
        if (!rows || !rows.length) return '<div class="an-empty">No data for this period.</div>';
        const isCurr = metricHeaders[0] && metricHeaders[0].toLowerCase().includes('revenue');
        const max = Math.max(...rows.map(r => r.metrics[0] || 0));
        const COLORS = ['#e8562a', '#3b82f6', '#059669', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4', '#10b981', '#d97706', '#6366f1'];
        return rows.map((r, i) => {
            const label = r.dims.join(' / ');
            const val = r.metrics[0];
            const pct = max ? Math.round((val / max) * 100) : 0;
            const valStr = isCurr ? '$' + fmt(val, true) : fmt(val);
            return '<div class="an-row">' +
                '<span class="an-row-label" title="' + label + '">' + label + '</span>' +
                '<div class="an-row-bar-wrap"><div class="an-row-bar" style="width:' + pct + '%;background:' + COLORS[i % COLORS.length] + '"></div></div>' +
                '<span class="an-row-val">' + valStr + '</span></div>';
        }).join('');
    }

    function renderCardBody(data) {
        if (data.timeSeries) {
            const isCurr = (data.metricHeaders[0] || '').toLowerCase().includes('revenue');
            return renderTrendChart(data, isCurr);
        }
        return renderBarRows(data);
    }

    /* ─── Grid builder ───────────────────────────────────────────────── */
    function buildGrid(propId) {
        const grid = document.getElementById('anGrid');
        const exportCsvIcon = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';

        grid.innerHTML = CARDS.map(c => {
            const cls = 'an-card' + (c.wide ? ' wide' : '') + (c.chartCard ? ' chart-card' : '');
            return '<div class="' + cls + '" id="card-' + c.type + '">' +
                '<div class="an-card-head">' +
                '<div class="an-card-icon" style="background:' + c.bg + '">' +
                '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="' + c.color + '" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + c.icon + '</svg></div>' +
                '<div><div class="an-card-title">' + c.title + '</div><div class="an-card-meta">' + c.sub + '</div></div>' +
                '<div class="an-card-actions">' +
                '<button class="an-act-btn" title="Export CSV" onclick="exportCardCsv(\'' + c.type + '\')">' + exportCsvIcon + '</button>' +
                '</div>' +
                '</div>' +
                '<div class="an-card-body" id="body-' + c.type + '">' + skeleton() + '</div></div>';
        }).join('');

        // Show export bar
        document.getElementById('anExportBar').style.display = '';

        CARDS.forEach(c => {
            fetch('/api/analytics-card/' + propId + '/' + c.type + '?range=' + currentRange)
                .then(r => r.json())
                .then(data => {
                    const el = document.getElementById('body-' + c.type);
                    if (!el) return;
                    if (data.error) { el.innerHTML = '<div class="an-error">&#9888; ' + data.error + '</div>'; return; }
                    // Store data for CSV export
                    cardDataStore[c.type] = data;
                    el.innerHTML = renderCardBody(data);
                    bindTooltips(el, c.type);
                    const rl = RANGE_LABELS[currentRange] || currentRange;
                    if (c.type === 'traffic-sources') { document.getElementById('sumSessions').textContent = fmt(data.totals[0]); document.getElementById('sumSessionsSub').textContent = rl; showSum(); }
                    if (c.type === 'browsers') { document.getElementById('sumNewUsers').textContent = fmt(data.totals[0]); document.getElementById('sumNewUsersSub').textContent = rl; showSum(); }
                    if (c.type === 'page-paths') { document.getElementById('sumPageviews').textContent = fmt(data.totals[0]); document.getElementById('sumPageviewsSub').textContent = rl; showSum(); }
                    if (c.type === 'events') { document.getElementById('sumEvents').textContent = fmt(data.totals[0]); document.getElementById('sumEventsSub').textContent = rl; showSum(); }
                    if (c.type === 'revenue-by-date') { document.getElementById('sumRevenue').textContent = '$' + fmt(data.totals[0], true); document.getElementById('sumRevenueSub').textContent = rl; showSum(); }
                })
                .catch(() => {
                    const el = document.getElementById('body-' + c.type);
                    if (el) el.innerHTML = '<div class="an-error">Network error</div>';
                });
        });
    }

    function showSum() { document.getElementById('anSummary').style.display = ''; }

    /* ─── Chart tooltip binding ──────────────────────────────────────── */
    function bindTooltips(container, type) {
        const tip = container.querySelector('#ct-' + type);
        if (!tip) return;
        container.querySelectorAll('.chart-hp').forEach(pt => {
            pt.addEventListener('mouseenter', () => { tip.textContent = pt.dataset.tip; tip.style.display = 'block'; });
            pt.addEventListener('mousemove', e => {
                const r = container.getBoundingClientRect();
                tip.style.left = (e.clientX - r.left + 14) + 'px';
                tip.style.top = (e.clientY - r.top - 34) + 'px';
            });
            pt.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
        });
    }

    /* ─── Live stats from realtime cache ─────────────────────────────── */
    async function loadLiveStats(propId) {
        document.getElementById('sumLiveUsers').textContent = '…';
        document.getElementById('sumLiveViews').textContent = '…';
        showSum();
        try {
            const r = await fetch('/api/realtime-summary/' + propId);
            const data = await r.json();
            if (data.ok) {
                document.getElementById('sumLiveUsers').textContent = fmt(data.activeUsers);
                document.getElementById('sumLiveViews').textContent = fmt(data.pageViews);
                document.getElementById('liveCacheAge').textContent =
                    data.cachedAgo < 5 ? 'just now' : data.cachedAgo + 's ago · 30 min window';
            } else {
                document.getElementById('sumLiveUsers').textContent = '—';
                document.getElementById('sumLiveViews').textContent = '—';
                document.getElementById('liveCacheAge').textContent = 'open dashboard to cache';
            }
        } catch {
            document.getElementById('sumLiveUsers').textContent = '—';
            document.getElementById('sumLiveViews').textContent = '—';
        }
    }

    /* ─── Event wiring ───────────────────────────────────────────────── */
    const PLACEHOLDER = '<div class="an-placeholder">' +
        '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">' +
        '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>' +
        '<rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>' +
        '</svg><p>Select a property above to load analytics cards</p></div>';

    document.getElementById('propPicker').addEventListener('change', e => {
        currentPropId = e.target.value;
        if (!currentPropId) {
            document.getElementById('anGrid').innerHTML = PLACEHOLDER;
            document.getElementById('anSummary').style.display = 'none';
            document.getElementById('anSubLabel').textContent = 'Select a property to begin';
            return;
        }
        document.getElementById('anSubLabel').textContent = (RANGE_LABELS[currentRange] || currentRange) + ' · non-realtime';
        buildGrid(currentPropId);
        loadLiveStats(currentPropId);
    });

    document.getElementById('rangeGroup').addEventListener('click', e => {
        const btn = e.target.closest('[data-range]');
        if (!btn) return;
        currentRange = btn.dataset.range;
        document.querySelectorAll('.an-range-btn').forEach(b => b.classList.toggle('active', b === btn));
        if (currentPropId) {
            document.getElementById('anSubLabel').textContent = (RANGE_LABELS[currentRange] || currentRange) + ' · non-realtime';
            buildGrid(currentPropId);
            loadLiveStats(currentPropId);
        }
    });

    /* ─── Export all CSV ─────────────────────────────────────────────── */
    document.getElementById('exportAllCsv').addEventListener('click', exportAllCsv);

    /* ─── Open in GA4 ────────────────────────────────────────────────── */
    document.getElementById('openGa4Btn').addEventListener('click', () => {
        if (!currentPropId) return;
        window.open('https://analytics.google.com/analytics/web/#/p' + currentPropId + '/reports/reportinghub', '_blank');
    });

    /* ─── Keyboard shortcuts ─────────────────────────────────────────── */
    document.addEventListener('keydown', e => {
        if (e.target.tagName === 'SELECT' || e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        switch (e.key.toLowerCase()) {
            case 'e':
                e.preventDefault();
                exportAllCsv();
                break;
            case 'r':
                e.preventDefault();
                if (currentPropId) {
                    buildGrid(currentPropId);
                    loadLiveStats(currentPropId);
                    toast('&#8635; Refreshing cards…');
                }
                break;
            case '1':
                e.preventDefault();
                document.querySelector('[data-range="today"]')?.click();
                break;
            case '2':
                e.preventDefault();
                document.querySelector('[data-range="7d"]')?.click();
                break;
            case '3':
                e.preventDefault();
                document.querySelector('[data-range="28d"]')?.click();
                break;
        }
    });
</script>