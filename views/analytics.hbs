    <!-- Export bar (shown when property selected) -->
    <div class="an-export-bar" id="anExportBar" style="display:none">
        <button class="an-export-btn" id="exportAllCsv" title="Export all cards as CSV">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export All CSV
        </button>
        <button class="an-export-btn" id="openGa4Btn" title="Open property in Google Analytics">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Open in GA4
        </button>
    </div>

    <!-- Summary stat bar -->
    <div class="an-summary" id="anSummary" style="display:none">
        <div class="an-stat-card">
            <div class="an-stat-accent" style="background:#22c374"></div>
            <div class="an-stat-label">Active Now</div>
            <div class="an-stat-num" id="sumLiveUsers">—</div>
            <div class="an-stat-sub"><span class="an-stat-live">realtime · last 30 min</span></div>
        </div>
        <div class="an-stat-card">
            <div class="an-stat-accent" style="background:#06b6d4"></div>
            <div class="an-stat-label">Live Pageviews</div>
            <div class="an-stat-num" id="sumLiveViews">—</div>
            <div class="an-stat-sub" id="liveCacheAge">30 min window</div>
        </div>
        <div class="an-stat-card">
            <div class="an-stat-accent" style="background:#e8562a"></div>
            <div class="an-stat-label">Sessions</div>
            <div class="an-stat-num" id="sumSessions">—</div>
            <div class="an-stat-sub" id="sumSessionsSub">—</div>
        </div>
        <div class="an-stat-card">
            <div class="an-stat-accent" style="background:#059669"></div>
            <div class="an-stat-label">New Users</div>
            <div class="an-stat-num" id="sumNewUsers">—</div>
            <div class="an-stat-sub" id="sumNewUsersSub">—</div>
        </div>
        <div class="an-stat-card">
            <div class="an-stat-accent" style="background:#3b82f6"></div>
            <div class="an-stat-label">Pageviews</div>
            <div class="an-stat-num" id="sumPageviews">—</div>
            <div class="an-stat-sub" id="sumPageviewsSub">—</div>
        </div>
        <div class="an-stat-card">
            <div class="an-stat-accent" style="background:#8b5cf6"></div>
            <div class="an-stat-label">Events</div>
            <div class="an-stat-num" id="sumEvents">—</div>
            <div class="an-stat-sub" id="sumEventsSub">—</div>
