<link rel="stylesheet" href="/css/panel.css" />
<style>
  .an { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .an-bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }
  .an-bar .l, .an-bar .r { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; min-width: 0; }
  .an-bar .l { flex: 1 1 320px; }
  .an-bar .l select { flex: 1 1 160px; min-width: 0; max-width: 360px; }
  .an-bar .seg { grid-template-columns: repeat(3, auto); }
  .an-bar .seg button { padding: 0 12px; }
  .an select { height: 32px; max-width: 100%; border: 1px solid var(--border-2); background: var(--surface); color: var(--text); border-radius: var(--r); font: 500 .8125rem var(--font); padding: 0 8px; }

  .an .c-strip .sums { grid-template-columns: repeat(2, auto); gap: 8px 24px; text-align: left; }
  .an .sums b { display: block; font-size: 1rem; font-weight: 600; }
  .an .sums span { font-size: .75rem; color: var(--text-3); }

  .split { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 12px; align-items: start; }
  .compact { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px; align-items: start; }
  .span2 { grid-column: span 2; }
  .card-h .tools { display: flex; gap: 6px; align-items: center; }
  .an .card-b { padding: 0 16px 16px; }
  .legend { display: flex; gap: 12px; font-size: .75rem; color: var(--text-2); }
  .legend i { display: inline-block; width: 10px; height: 2px; vertical-align: middle; margin-right: 4px; }

  .scroll { overflow-x: auto; }
  .tbl td.lc { max-width: 0; min-width: 110px; width: 100%; }
  .lbl { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lbl a { color: inherit; text-decoration: none; }
  .lbl a:hover { text-decoration: underline; }
  .lbl svg { display: inline-block; width: 12px; height: 12px; vertical-align: -2px; margin-right: 4px; color: var(--text-3); }
  .tbl tr.grp td { padding-top: 12px; font-weight: 500; }
  .bar3 { height: 3px; background: var(--surface-3); margin-top: 4px; }
  .bar3 i { display: block; height: 100%; background: var(--c1); opacity: .55; }
  .d-up { color: var(--good); }
  .d-dn { color: var(--bad); }

  .chg { list-style: none; margin: 0; padding: 0; }
  .chg li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 12px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .chg li:last-child { border-bottom: 0; }
  .chg .why { grid-column: 1 / -1; font-size: .75rem; color: var(--text-3); }

  .an .chart .prev { fill: none; stroke: var(--text-3); stroke-width: 1; stroke-dasharray: 3 3; }
  .an .chart .hover { stroke: var(--border-2); stroke-width: 1; }
  .trend-b { position: relative; }
  .tip { position: absolute; top: 0; left: 0; pointer-events: none; background: var(--surface); border: 1px solid var(--border-2); border-radius: var(--r-lg); box-shadow: var(--pop-shadow); padding: 6px 8px; font-size: .75rem; white-space: nowrap; opacity: 0; transition: opacity .12s var(--ease-out); }
  .tip.on { opacity: 1; }

  .skel { display: grid; gap: 10px; padding-top: 4px; }
  .skel i { display: block; height: 12px; background: var(--surface-3); border-radius: var(--r); }
  .empty { color: var(--text-3); font-size: .8125rem; padding: 8px 0; margin: 0; }

  @media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 700px) { .span2 { grid-column: auto; } }
  @media (max-width: 860px) { .an .c-strip .sums { grid-template-columns: repeat(4, auto); justify-content: start; } }
  @media (max-width: 480px) { .an .c-strip .sums { grid-template-columns: repeat(2, auto); } }
</style>

<div class="panel an" id="anPage">
  <div class="an-bar">
    <div class="l">
      <select id="anProp" aria-label="Property">
        {{#each properties}}<option value="{{id}}">{{site}}{{#if domain}} · {{domain}}{{/if}}</option>{{/each}}
      </select>
      <div class="seg" role="group" aria-label="Range" id="anRange">
        <button type="button" data-range="today" aria-pressed="false">Today</button>
        <button type="button" data-range="7d" aria-pressed="false">7d</button>
        <button type="button" data-range="28d" aria-pressed="true">28d</button>
      </div>
    </div>
    <div class="r">
      <span class="badge" id="anFresh">Loading</span>
      <button type="button" class="btn" id="anExport" title="Export all cards (E)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/></svg>Export CSV</button>
      <a class="btn" id="anGa4" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>Open in GA4</a>
      <button type="button" class="btn" id="anRefresh" title="Refresh (R)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>Refresh</button>
    </div>
  </div>

  <section class="card c-strip" aria-label="Live now and period totals">
    <div>
      <div class="small muted"><span class="dot"></span> Live now</div>
      <div class="hero-n num" id="anLive">0</div>
      <div class="cap faint num" id="anLiveViews">&nbsp;</div>
    </div>
    <div class="chart" id="anLiveChart"></div>
    <div class="sums" id="anSums"></div>
  </section>

  <div class="split">
    <section class="card">
      <div class="card-h">
        <div class="seg seg-inline" role="group" aria-label="Trend metric" id="anTrendSeg">
          <button type="button" data-i="1" aria-pressed="true">Sessions</button>
          <button type="button" data-i="0" aria-pressed="false">New users</button>
          <button type="button" data-i="2" aria-pressed="false">Revenue</button>
        </div>
        <div class="legend"><span><i style="background:var(--c1)"></i>This period</span><span><i style="background:var(--text-3)"></i><span class="an-prev">Previous 28 days</span></span></div>
      </div>
      <div class="card-b trend-b chart" id="anTrend"></div>
    </section>
    <section class="card">
      <div class="card-h"><h2>What changed</h2><span class="cap faint">vs <span class="an-prev an-lc">previous 28 days</span></span></div>
      <div class="card-b"><ul class="chg" id="anChg"></ul></div>
    </section>
  </div>

  <div class="compact" id="anGrid"></div>

  <section class="card">
    <div class="card-h"><h2>Spikes</h2></div>
    <div class="card-b" id="anSpikes"></div>
  </section>
</div>

<script>
  const PROPERTIES = {{{ json_stringify properties }}};
  const CARDS = {{{ json_stringify analyticsCatalog }}};
</script>
<script src="/js/analytics.js"></script>
