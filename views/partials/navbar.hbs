                stroke-linecap="round" stroke-linejoin="round" style="color:var(--nav-accent)">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
            <span class="nav-brand-text"><span style="color:var(--nav-accent)">GA4</span> Live</span>
        </a>
        <div class="nav-links" id="navLinks">
            <a class="nav-link" href="/" id="nlDash">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>
            <a class="nav-link" href="/globe" id="nlGlobe">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <path
                        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
                Globe
            </a>
            <a class="nav-link" href="/analytics" id="nlAnalytics">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
                Analytics
            </a>
        </div>
    <div class="nav-right">
        <div class="nav-live" title="Realtime data">
            <span class="nav-live-dot"></span>
            <span class="nav-live-label">Live</span>
        </div>
        <button class="nav-icon-btn" id="themeToggle" title="Toggle dark / light mode" aria-label="Toggle theme">
            <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2">
                <circle cx="12" cy="12" r="5" />
                <line x1="12" y1="1" x2="12" y2="3" />
                <line x1="12" y1="21" x2="12" y2="23" />
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                <line x1="1" y1="12" x2="3" y2="12" />
                <line x1="21" y1="12" x2="23" y2="12" />
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
            <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" style="display:none">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
        </button>
        <button class="nav-icon-btn nav-hamburger" id="navHamburger" aria-label="Menu">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>
    </div>
    </div>
</nav>

<style>
    :root {
        --nav-bg: #ffffff;
        --nav-border: #ebebeb;
        --nav-text: #18181c;
        --nav-muted: #78756f;
        --nav-link-active-bg: #f4f1ec;
        --nav-link-active-color: #18181c;
        --nav-accent: #e8562a;
        --nav-live: #059669
    }

    [data-theme="dark"] {
        --nav-bg: #0f0f14;
        --nav-border: rgba(255, 255, 255, 0.07);
        --nav-text: #e4e2dd;
        --nav-muted: #6b6880;
        --nav-link-active-bg: rgba(255, 255, 255, 0.08);
        --nav-link-active-color: #e4e2dd;
        --nav-accent: #e8562a;
        --nav-live: #22c374
    }

    #appNav {
        background: var(--nav-bg);
        border-bottom: 1px solid var(--nav-border);
        position: sticky;
        top: 0;
        z-index: 200;
        transition: background 200ms ease, border-color 200ms ease
    }

    .nav-inner {
        max-width: 1340px;
        margin: 0 auto;
        padding: 0 20px;
        height: 52px;
        display: flex;
        align-items: center;
        gap: 12px
    }

    .nav-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        flex-shrink: 0
    }

    .nav-brand-text {
        font-family: 'Syne', system-ui, sans-serif;
        font-size: 15px;
        font-weight: 800;
        color: var(--nav-text);
        letter-spacing: -.01em;
        transition: color 200ms ease
    }

    .nav-links {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2px
    }

    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 7px;
        font-family: 'Syne', system-ui, sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .03em;
        color: var(--nav-muted);
        text-decoration: none;
        background: transparent;
        transition: background 140ms ease, color 140ms ease
    }

    .nav-link:hover,
    .nav-link.active {
        background: var(--nav-link-active-bg);
        color: var(--nav-link-active-color)
    }

    .nav-right {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0
    }

    .nav-live {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 4px 9px;
        border-radius: 6px;
        background: rgba(5, 150, 105, 0.1);
        border: 1px solid rgba(5, 150, 105, 0.18)
    }

    .nav-live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--nav-live);
        animation: navPulse 1.8s ease-in-out infinite
    }

    @keyframes navPulse {

        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(5, 150, 105, .45)
        }

        50% {
            box-shadow: 0 0 0 4px rgba(5, 150, 105, 0)
        }
    }

    .nav-live-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--nav-live)
    }

    .nav-icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid var(--nav-border);
        background: transparent;
        color: var(--nav-muted);
        cursor: pointer;
        transition: background 140ms ease, color 140ms ease
    }

    .nav-icon-btn:hover {
        background: var(--nav-link-active-bg);
        color: var(--nav-link-active-color)
    }

    .nav-hamburger {
        display: none
    }

    @media(max-width:640px) {
        .nav-links {
            display: none
        }

        .nav-hamburger {
            display: flex
        }

        .nav-links.mobile-open {
            display: flex;
            flex-direction: column;
            position: absolute;
            top: 52px;
            left: 0;
            right: 0;
            background: var(--nav-bg);
            border-bottom: 1px solid var(--nav-border);
            padding: 8px 16px 12px;
            gap: 4px;
            z-index: 199
        }
    }

    /* ── Dark mode global page background ── */
    [data-theme="dark"] body {
        background: #0f0f14 !important;
        color: #e4e2dd
    }

    [data-theme="dark"] .bg-gray-100 {
        background: #0f0f14 !important
    }
</style>

<script>
    (function () {
        var root = document.documentElement;
        var THEME_KEY = 'ga4_theme';
        var saved = localStorage.getItem(THEME_KEY) || 'light';
        applyTheme(saved);
        function applyTheme(t) {
            root.setAttribute('data-theme', t);
            var sun = document.querySelector('.icon-sun');
            var moon = document.querySelector('.icon-moon');
            if (sun && moon) { sun.style.display = t === 'dark' ? 'none' : ''; moon.style.display = t === 'dark' ? '' : 'none'; }
        }
        document.getElementById('themeToggle')?.addEventListener('click', function () {
            var cur = root.getAttribute('data-theme') || 'light';
            var next = cur === 'dark' ? 'light' : 'dark';
            localStorage.setItem(THEME_KEY, next);
            applyTheme(next);
        });
        var path = location.pathname;
        var map = { '/': 'nlDash', '/globe': 'nlGlobe', '/analytics': 'nlAnalytics' };
        for (var p in map) { if (path === p || path.startsWith(p + '?')) { var el = document.getElementById(map[p]); if (el) el.classList.add('active'); break; } }
        document.getElementById('navHamburger')?.addEventListener('click', function () {
            document.getElementById('navLinks')?.classList.toggle('mobile-open');
        });
    })();
</script>
