<style>
  /* ── Navbar: Zed/DESIGN.md tokens ──────────────────────────── */
  :root {
    --n-bg: #ffffff;
    --n-bdr: #e5e7eb;
    --n-text: #3a3d43;
    --n-link: #5d636f;
    --n-muted: #878a98;
    --n-accent: #1348dc;
    --n-signal: #2b7fff;
    --n-ice: #e6effe;
    --n-cobalt: #053794;
    --n-green: #059669;
    --n-sans: 'Inter', 'IBM Plex Sans', system-ui, sans-serif;
    --n-serif: 'Plex Serif', Georgia, serif;
    --n-mono: 'Zed Mono', 'JetBrains Mono', ui-monospace, monospace;
    --n-radius: 2px;
  }

  [data-theme="dark"] {
    --n-bg: #0f0f14;
    --n-bdr: rgba(255, 255, 255, 0.08);
    --n-text: #e4e2dd;
    --n-link: #8a8890;
    --n-muted: #5a5870;
    --n-accent: #2b7fff;
    --n-ice: rgba(43, 127, 255, 0.12);
    --n-cobalt: #2b7fff;
    --n-green: #22c374;
  }

  #appNav {
    background: var(--n-bg);
    border-bottom: 1px solid var(--n-bdr);
    position: sticky;
    top: 0;
    z-index: 200;
    transition: background 200ms ease, border-color 200ms ease;
  }

  .nav-inner {
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 20px;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
    padding-right: 12px;
  }

  .nav-brand svg {
    color: var(--n-accent);
  }

  .nav-brand-text {
    font-family: var(--n-serif);
    font-size: 16px;
    font-weight: 400;
    color: var(--n-accent);
    letter-spacing: -0.02em;
    transition: color 200ms ease;
  }

  .nav-links {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: var(--n-radius);
    position: relative;
    font-family: var(--n-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: -0.025em;
    color: var(--n-link);
    text-decoration: none;
    background: transparent;
    transition: color 140ms ease, background 140ms ease;
    /* 2px inset top-border space, default transparent */
    box-shadow: inset 0 0 0 0 transparent;
  }

  .nav-link svg { flex-shrink: 0; }

  .nav-link:hover {
    color: var(--n-accent);
  }

  .nav-link.active {
    color: var(--n-text);
    background: var(--n-ice);
    /* 2px inset Deep Cobalt top-border */
    box-shadow: var(--n-cobalt) 0px -2px 0px 0px inset;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .nav-live {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    border-radius: var(--n-radius);
    border: 1px solid rgba(5, 150, 105, 0.2);
    background: rgba(5, 150, 105, 0.08);
  }

  .nav-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--n-green);
    animation: nPulse 1.8s ease-in-out infinite;
  }

  @keyframes nPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.45); }
    50% { box-shadow: 0 0 0 4px rgba(5, 150, 105, 0); }
  }

  .nav-live-label {
    font-family: var(--n-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--n-green);
  }

  .nav-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--n-radius);
    border: 1px solid #cccfd3;
    background: transparent;
    color: var(--n-muted);
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
  }

  .nav-icon-btn:hover {
    background: var(--n-ice);
    color: var(--n-accent);
    border-color: var(--n-accent);
  }

  .nav-hamburger {
    display: none;
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }

    .nav-hamburger {
      display: flex;
    }

    .nav-links.mobile-open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 52px;
      left: 0;
      right: 0;
      background: var(--n-bg);
      border-bottom: 1px solid var(--n-bdr);
      padding: 8px 16px 12px;
      gap: 4px;
      z-index: 199;
    }

    .nav-links.mobile-open .nav-link {
      padding: 8px 12px;
    }
  }

  /* ── Dark mode global overrides ── */
  [data-theme="dark"] body {
    background: #0f0f14 !important;
    color: #e4e2dd;
  }

  [data-theme="dark"] .bg-gray-100 {
    background: #0f0f14 !important;
  }

  [data-theme="dark"] .nav-icon-btn {
    border-color: rgba(255, 255, 255, 0.15);
  }

  [data-theme="dark"] .nav-live {
    border-color: rgba(34, 195, 116, 0.25);
    background: rgba(34, 195, 116, 0.1);
  }
</style>

<script>
  (function() {
    const root = document.documentElement;
    const THEME_KEY = 'pb_theme';
    const saved = localStorage.getItem(THEME_KEY) || 'light';
    applyTheme(saved);

    function applyTheme(t) {
      root.setAttribute('data-theme', t);
      const sun = document.querySelector('.icon-sun');
      const moon = document.querySelector('.icon-moon');
      if (sun && moon) {
        sun.style.display = t === 'dark' ? 'none' : '';
        moon.style.display = t === 'dark' ? '' : 'none';
      }
    }

    document.getElementById('themeToggle')?.addEventListener('click', function() {
      const cur = root.getAttribute('data-theme') || 'light';
      const next = cur === 'dark' ? 'light' : 'dark';
      localStorage.setItem(THEME_KEY, next);
      applyTheme(next);
    });

    // Active nav link based on current path
    const path = location.pathname;
    const map = { '/': 'nlDash', '/globe': 'nlGlobe', '/analytics': 'nlAnalytics' };
    for (const p in map) {
      if (path === p || path.startsWith(p + '?')) {
        const el = document.getElementById(map[p]);
        if (el) el.classList.add('active');
        break;
      }
    }

    document.getElementById('navHamburger')?.addEventListener('click', function() {
      document.getElementById('navLinks')?.classList.toggle('mobile-open');
    });
  })();
</script>
