<style>
  /* ─── Design tokens ──────────────────────────────────────────── */
  :root {
    --page-bg: #e5e7eb;
    --hdr-bg: #ffffff;
    --card-bg: #ffffff;
    --card-bdr: #cccfd3;
    --accent: #1348dc;
    --signal: #2b7fff;
    --ice: #e6effe;
    --off-white: #f4f4f2;
    --green: #059669;
    --amber: #d97706;
    --danger: #dc2626;
    --text: #3a3d43;
    --muted: #5d636f;
    --xmuted: #878a98;
    --mono: 'Zed Mono', 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', 'IBM Plex Sans', system-ui, sans-serif;
    --serif: 'Plex Serif', Georgia, serif;
    --radius: 2px;
    --ease-out: cubic-bezier(0.215, 0.61, 0.355, 1);
    --ease-io: cubic-bezier(0.645, 0.045, 0.355, 1);
  }

  [data-theme="dark"] {
    --page-bg: #0f0f14;
    --hdr-bg: #18181c;
    --card-bg: #1a1a22;
    --card-bdr: rgba(255, 255, 255, 0.08);
    --text: #e4e2dd;
    --muted: #8a8890;
    --xmuted: #5a5870;
  }

  /* ─── Base ───────────────────────────────────────────────────── */
  body {
    background: var(--page-bg) !important;
    background-image: radial-gradient(#cccfd3 1px, transparent 1px) !important;
    background-size: 8px 8px !important;
  }

  .dash-wrap {
    font-family: var(--sans);
    color: var(--text);
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px 48px;
  }

  /* ─── Top header strip ───────────────────────────────────────── */
  .dash-hdr {
    background: var(--hdr-bg);
    border: 1px solid var(--card-bdr);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .dash-title {
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 340;
    letter-spacing: -0.02em;
    color: var(--accent);
    margin: 0 0 8px;
  }

  .dash-stats-row {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }

  .ds-block {
    display: flex;
    flex-direction: column;
  }

  .ds-num {
    font-family: var(--mono);
    font-size: 32px;
    line-height: 1;
    {{!-- color: #ffffff; --}}
    letter-spacing: -.02em;
  }

  .ds-num.accent {
    color: var(--accent);
  }

  .ds-num.green {
    color: var(--green);
  }

  .ds-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 5px;
  }

  /* ─── Actions toolbar ────────────────────────────────────────── */
  .dash-tools {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .tool-btn {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .05em;
    padding: 8px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--card-bdr);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .tool-btn:hover {
    background: var(--ice);
    color: var(--accent);
    border-color: var(--signal);
  }

  .tool-btn.accent-btn {
    background: var(--signal);
    border-color: var(--signal);
    color: #ffffff;
  }

  .tool-btn.accent-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .tool-btn:active {
    transform: scale(0.97);
  }

  .refresh-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--muted);
  }

  .refresh-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
  }

  #refreshCountdown {
    font-family: var(--mono);
    color: var(--muted);
  }

  /* ─── Auto-refresh toggle ────────────────────────────────────── */
  .toggle-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
    cursor: pointer;
  }

  .toggle-switch {
    width: 36px;
    height: 20px;
    background: #d8d8d8;
    border-radius: 999px;
    position: relative;
    transition: background 200ms ease;
    flex-shrink: 0;
  }

  .toggle-switch::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    background: #ffffff;
    border-radius: 999px;
    top: 3px;
    left: 3px;
    transition: transform 200ms var(--ease-out), background 200ms ease;
  }

  .toggle-wrap.is-on .toggle-switch {
    background: var(--green);
  }

  .toggle-wrap.is-on .toggle-switch::after {
    background: #fff;
    transform: translateX(16px);
  }

  /* ─── Rate limit panel ───────────────────────────────────────── */
  .quota-panel {
    background: #ffffff;
    border: 1px solid var(--card-bdr);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .quota-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .quota-meters {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    flex: 1;
  }

  .quota-meter {
    flex: 1;
    min-width: 160px;
  }

  .qm-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 11px;
  }

  .qm-name {
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .qm-val {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text);
  }

  .qm-bar-bg {
    height: 5px;
    background: var(--off-white);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .qm-bar-fill {
    height: 100%;
    border-radius: var(--radius);
    background: var(--green);
    width: 0;
    transition: width 800ms var(--ease-io);
  }

  .qm-bar-fill.amber {
    background: var(--amber);
  }

  .qm-bar-fill.danger {
    background: var(--danger);
  }

  .quota-none {
    font-size: 12px;
    color: var(--xmuted);
  }

  /* ─── Sort toolbar ───────────────────────────────────────────── */
  .sort-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .sort-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--xmuted);
  }

  .sort-btn {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .05em;
    padding: 5px 12px;
    border-radius: var(--radius);
    border: 1px solid var(--card-bdr);
    background: var(--card-bg);
    color: var(--muted);
    cursor: pointer;
    transition: all 140ms ease;
  }

  .sort-btn:hover {
    background: var(--ice);
    border-color: var(--signal);
    color: var(--accent);
  }

  .sort-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* ─── Privacy mode (Strictly hides URLs, domains, site names) ───── */
  body.privacy-blur .prop-name,
  body.privacy-blur .prop-sub,
  body.privacy-blur .prop-favicon-wrap,
  body.privacy-blur .prop-link-btn,
  body.privacy-blur .prop-actions-toggle,
  body.privacy-blur .prop-actions-menu,
  body.privacy-blur .prop-action-link,
  body.privacy-blur .cd-page,
  body.privacy-blur [data-privacy],
  body.privacy-blur [data-domain] {
    filter: blur(8px) !important;
    user-select: none !important;
    pointer-events: none !important;
    opacity: 0.35 !important;
    transition: filter 200ms ease;
  }

  body.privacy-blur .prop-name:hover,
  body.privacy-blur .prop-sub:hover,
  body.privacy-blur .prop-favicon-wrap:hover {
    filter: blur(8px) !important;
  }

  .tool-btn.is-active {
    background: var(--ice);
    color: var(--accent);
    border-color: var(--signal);
  }

  /* ─── Property card ──────────────────────────────────────────── */
  .dash-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .prop-card {
    background: var(--card-bg);
    border: 1px solid var(--card-bdr);
    border-radius: var(--radius);
    padding: 18px 20px 16px;
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 220ms cubic-bezier(0.215, 0.61, 0.355, 1),
      transform 220ms cubic-bezier(0.215, 0.61, 0.355, 1),
      border-color 180ms ease,
      box-shadow 180ms ease;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 188px;
  }

  .prop-card.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .prop-card:hover {
    border-color: var(--signal);
    box-shadow: rgba(111, 123, 144, 0.1) 0 -2px 0 0 inset;
  }

  .prop-card.has-users {
    border-color: #bedbff;
  }

  .prop-card.is-error {
    opacity: .55 !important;
  }

  .prop-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 0;
  }

  .prop-favicon-wrap {
    width: 28px;
    height: 28px;
    border-radius: var(--radius);
    overflow: hidden;
    flex-shrink: 0;
    background: var(--off-white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prop-favicon {
    width: 28px;
    height: 28px;
    object-fit: cover;
    display: block;
  }

  .prop-name {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    min-width: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: normal;
  }

  .prop-main {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .prop-sub {
    font-size: 10px;
    color: var(--xmuted);
    font-family: var(--mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .prop-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding-top: 2px;
    position: relative;
  }

  .prop-actions-toggle {
    border: 1px solid var(--card-bdr);
    border-radius: var(--radius);
    background: var(--card-bg);
    color: var(--muted);
    font: 600 10px var(--sans);
    padding: 5px 7px;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .prop-actions-toggle:hover,
  .prop-actions-toggle[aria-expanded="true"],
  .prop-actions-toggle:focus-visible {
    background: var(--ice);
    color: var(--accent);
    border-color: var(--signal);
    outline: none;
  }

  .prop-actions-menu {
    position: absolute;
    z-index: 5;
    top: calc(100% + 6px);
    right: 0;
    min-width: 142px;
    padding: 4px;
    border: 1px solid var(--card-bdr);
    border-radius: var(--radius);
    background: var(--card-bg);
    box-shadow: 0 8px 18px rgba(15, 18, 25, .14);
  }

  .prop-action-link {
    display: block;
    padding: 7px 8px;
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 11px;
    text-decoration: none;
    white-space: nowrap;
  }

  .prop-action-link:hover,
  .prop-action-link:focus-visible {
    background: var(--ice);
    color: var(--accent);
    outline: none;
  }

  .prop-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius);
    border: none;
    background: transparent;
    color: var(--xmuted);
    cursor: pointer;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 150ms ease, color 150ms ease;
  }

  .prop-link-btn:hover {
    background: var(--ice);
    color: var(--accent);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  @keyframes pulse-dot {

    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(5, 150, 105, .4);
    }

    50% {
      box-shadow: 0 0 0 5px rgba(5, 150, 105, 0);
    }
  }

  .prop-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--card-bdr);
  }

  .prop-stat {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 12px 12px 10px;
    border-radius: var(--radius);
    background: var(--off-white);
    border: 1px solid var(--card-bdr);
  }

  .prop-stat-num {
    font-family: var(--mono);
    font-size: 24px;
    line-height: 1;
    color: var(--text);
    letter-spacing: -.02em;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .prop-stat-num.green {
    color: var(--green);
  }

  .prop-stat-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--xmuted);
    margin-top: 4px;
  }

  .prop-error-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--danger);
    background: #fef2f2;
    border-radius: var(--radius);
    padding: 3px 7px;
  }

  /* ─── Card detail modal ──────────────────────────────────────── */
  .card-modal {
    padding: 0;
    border: 1px solid var(--card-bdr);
    border-radius: var(--radius);
    background: var(--card-bg);
    color: var(--text);
    width: min(640px, calc(100vw - 32px));
    max-height: min(720px, calc(100vh - 64px));
    box-shadow: rgba(0, 0, 0, 0.15) 0 20px 50px -12px;
    overflow: hidden; /* only .card-modal-body scrolls, not the dialog itself */
    display: flex;
    flex-direction: column;
  }

  .card-modal::backdrop {
    background: rgba(15, 18, 25, 0.45);
    opacity: 0;
    transition: opacity 220ms ease-out;
  }

  .card-modal[open]::backdrop {
    opacity: 1;
  }

  .card-modal {
    opacity: 1;
    transform: scale(1);
    transition: opacity 220ms ease-out, transform 220ms ease-out, overlay 220ms ease-out allow-discrete, display 220ms ease-out allow-discrete;
  }

  @starting-style {
    .card-modal[open] {
      opacity: 0;
      transform: scale(0.95);
    }
  }

  .card-modal:not([open]) {
    opacity: 0;
    transform: scale(0.95);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-modal,
    .card-modal::backdrop {
      transition: none;
    }
  }

  .card-modal-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--card-bdr);
  }

  .card-modal-title {
    min-width: 0;
    flex: 1;
  }

  .card-modal-name {
    font-size: 14px;
    font-weight: 700;
  }

  .card-modal-sub {
    font-size: 10px;
    color: var(--xmuted);
    font-family: var(--mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-modal-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .card-modal-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius);
    border: none;
    background: transparent;
    color: var(--xmuted);
    cursor: pointer;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }

  .card-modal-btn:hover {
    background: var(--ice);
    color: var(--accent);
  }

  .card-modal-body {
    padding: 16px 18px 18px;
    overflow-y: auto;
    flex: 1;
    min-height: 0;
    scrollbar-width: thin; /* Firefox */
    scrollbar-color: var(--card-bdr) transparent;
  }

  .card-modal-body::-webkit-scrollbar {
    width: 6px;
  }

  .card-modal-body::-webkit-scrollbar-thumb {
    background: var(--card-bdr);
    border-radius: 3px;
  }

  .card-modal-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .cd-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--green);
    margin-left: 6px;
  }

  .cd-live-badge .live-dot {
    width: 5px;
    height: 5px;
  }

  .cd-loading {
    font-size: 11px;
    color: var(--xmuted);
    padding: 8px 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cd-section {
    margin-bottom: 12px;
  }

  .cd-section:last-child {
    margin-bottom: 0;
  }

  .cd-title {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--xmuted);
    margin-bottom: 7px;
  }

  .cd-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 0;
    font-size: 12px;
    color: var(--text);
  }

  .cd-bar-wrap {
    flex: 1;
    height: 3px;
    background: var(--off-white);
    border-radius: 2px;
    overflow: hidden;
  }

  .cd-bar {
    height: 100%;
    background: var(--signal);
    border-radius: 2px;
  }

  .cd-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    flex-shrink: 0;
    min-width: 22px;
    text-align: right;
  }

  .cd-page {
    font-size: 11px;
    font-family: var(--mono);
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    max-width: 140px;
  }

  .prop-alert {
    border: 1px solid #bedbff;
    border-radius: var(--radius);
    background: var(--ice);
    color: var(--text);
    box-shadow: rgba(111, 123, 144, 0.05) 0 -2px 0 0 inset;
  }

  .prop-alert-title {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .05em;
    color: var(--accent);
  }

  .prop-alert-copy {
    font-size: 11px;
    line-height: 1.4;
    color: var(--muted);
  }

  .prop-alert {
    width: 100%;
    text-align: left;
    padding: 9px 10px;
    cursor: pointer;
    font-family: var(--sans);
    display: flex;
    flex-direction: column;
    gap: 3px;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .prop-alert:active {
    transform: scale(0.99);
  }

  .persona-section {
    border-top: 1px solid var(--card-bdr);
    padding-top: 12px;
  }

  .persona-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
  }

  .persona-range {
    display: inline-flex;
    gap: 4px;
    padding: 2px;
    background: var(--off-white);
    border: 1px solid var(--card-bdr);
    border-radius: var(--radius);
  }

  .persona-range button {
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 10px var(--mono);
    padding: 4px 6px;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .persona-range button.active {
    background: var(--ice);
    color: var(--accent);
  }

  .persona-grid {
    display: grid;
    gap: 8px;
  }

  .persona-card {
    border: 1px solid var(--card-bdr);
    background: var(--off-white);
    border-radius: var(--radius);
    padding: 10px;
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease;
  }

  .persona-card:hover,
  .persona-card.is-open {
    border-color: var(--signal);
    background: #fff;
  }

  .persona-card-main {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: start;
  }

  .persona-name {
    font-weight: 700;
    font-size: 12px;
    color: var(--text);
  }

  .persona-intent {
    font-size: 11px;
    color: var(--accent);
    margin-top: 2px;
  }

  .persona-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
    gap: 6px;
    margin-top: 8px;
  }

  .persona-metric {
    border: 1px solid var(--card-bdr);
    background: #fff;
    border-radius: var(--radius);
    padding: 6px;
  }

  .persona-metric strong {
    display: block;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text);
  }

  .persona-metric span,
  .persona-note {
    font-size: 10px;
    color: var(--muted);
  }

  .persona-detail {
    display: none;
    margin-top: 10px;
    gap: 10px;
  }

  .persona-card.is-open .persona-detail {
    display: grid;
  }

  .persona-mini-title {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .06em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 5px;
  }

  .persona-list-row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 4px 0;
    border-top: 1px solid var(--card-bdr);
    font-size: 11px;
    color: var(--muted);
  }

  .persona-list-row span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ─── Foot ──────────────────────────────────────────────────── */
  .dash-foot {
    margin-top: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 11px;
    color: var(--xmuted);
  }

  .dash-foot-meta {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .foot-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .foot-key {
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .foot-val {
    font-family: var(--mono);
  }

  .foot-mcp {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--xmuted);
  }

  /* ─── Spinning icon for in-flight refresh ────────────────────── */
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .spinning {
    animation: spin 700ms linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .spinning {
      animation: none;
    }
  }

  /* ─── Keyboard hint bar ─────────────────────────────────── */
  .kbd-hint-bar {
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 14px;
    font-size: 10px;
    color: var(--xmuted);
    z-index: 10;
    pointer-events: none;
    opacity: 0.6;
  }
  .kbd-hint-bar kbd {
    background: var(--card-bg);
    border: 1px solid var(--card-bdr);
    border-radius: 4px;
    padding: 1px 5px;
    font-family: var(--mono);
    font-size: 10px;
    margin-right: 3px;
  }

  /* ─── Dark mode quota ──────────────────────────────────── */
  [data-theme="dark"] .quota-panel {
    background: var(--card-bg);
    border-color: var(--card-bdr);
  }
  [data-theme="dark"] .qm-bar-bg {
    background: rgba(255,255,255,0.06);
  }
  [data-theme="dark"] .cd-bar-wrap {
    background: rgba(255,255,255,0.06);
  }
  [data-theme="dark"] .dash-foot code {
    background: rgba(255,255,255,0.08);
    color: var(--muted);
  }
  [data-theme="dark"] .prop-link-btn:hover {
    background: rgba(255,255,255,0.08);
  }
  [data-theme="dark"] .prop-favicon-wrap {
    background: rgba(255,255,255,0.06);
  }
  [data-theme="dark"] .prop-error-tag {
    background: rgba(239,68,68,0.12);
  }
  [data-theme="dark"] .prop-stat {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.06);
  }

  @media (max-width: 900px) {
    .dash-wrap {
      padding: 0 16px 40px;
    }
    .dash-hdr,
    .quota-panel {
      padding: 20px;
    }
  }

  @media (max-width: 640px) {
    .dash-grid {
      grid-template-columns: 1fr;
    }
    .prop-card {
      padding: 16px;
      min-height: 0;
    }
    .prop-stats {
      gap: 8px;
    }
    .kbd-hint-bar {
      display: none;
    }
  }
</style>

{{!-- ────────────────────────────────────────────────────── --}}
<div class="dash-wrap">

  {{!-- Header strip --}}
  <div class="dash-hdr">
    <div>
      <p class="dash-title">Pulseboard</p>
      <div class="dash-stats-row">
        <div class="ds-block">
          <span class="ds-num green" id="jsTotal">{{totalActiveUsers}}</span>
          <span class="ds-label">Active Now</span>
        </div>
        <div class="ds-block">
          <span class="ds-num" id="jsTotalViews">{{totalPageViews}}</span>
          <span class="ds-label">Page Views (30m)</span>
        </div>
        <div class="ds-block">
          <span class="ds-num accent">{{accessibleCount}}</span>
          <span class="ds-label">Properties</span>
        </div>
        {{#if errorCount}}
        <div class="ds-block">
          <span class="ds-num" style="color:#f87171">{{errorCount}}</span>
          <span class="ds-label">Errors</span>
        </div>
        {{/if}}
      </div>
      </div>

      <div class="dash-tools">
        <div class="refresh-indicator">
          {{!-- <div class="refresh-dot" id="jsDot"></div> --}}
          <span id="refreshCountdown"></span>
        </div>
        <div class="toggle-wrap" id="autoRefreshToggle" title="Auto-refresh every 5 min">
          <div class="toggle-switch"></div>
          <span>Auto</span>
        </div>
        <button class="tool-btn" id="privacyBtn" title="Toggle privacy mode">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-right:5px">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          Privacy Mode
        </button>
        <button class="tool-btn" id="reloadBtn" onclick="location.reload()">
          <svg id="reloadIcon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-right:5px">
            <polyline points="23 4 23 10 17 10" />
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
          </svg>
          Reload
        </button>
        <button class="tool-btn accent-btn" id="refreshCacheBtn">
          Refresh Properties
        </button>
      </div>
      </div>
{{!-- Rate limit panel --}}
<div class="quota-panel" id="quotaPanel">
    <div>
      <div class="quota-label">API Rate Limit</div>
      </div>
      <div class="quota-meters" id="quotaMeters">
        <div class="quota-none" id="quotaNone">No quota data — make at least one successful API call.</div>
      </div>
      </div>

      {{!-- Sort toolbar --}}
      <div class="sort-bar">
        <span class="sort-label">Sort</span>
        <button class="sort-btn" data-sort="active">Active Users</button>
        <button class="sort-btn" data-sort="views">Page Views</button>
        <button class="sort-btn" data-sort="name">Name</button>
      </div>

      {{!-- Property cards --}}
      <div class="dash-grid" id="propGrid">
        {{#each data}}
        <div class="prop-card {{#if this.activeUsers}}has-users{{/if}} {{#if this.error}}is-error{{/if}}"
          data-active="{{this.activeUsers}}" data-views="{{this.pageViews}}" data-name="{{this.siteName}}"
          data-pid="{{this.propertyId}}">

          <div class="prop-head">
            <div class="prop-favicon-wrap">
              {{#if this.domain}}
              <img class="prop-favicon" src="https://favicon.im/{{this.domain}}?larger=true" alt="" width="28" height="28"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              {{/if}}
              <div class="prop-favicon-fallback"
                style="display:{{#if this.domain}}none{{else}}flex{{/if}};align-items:center;justify-content:center;width:100%">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              </div>
            </div>
          <div class="prop-main">
            <span class="prop-name">{{this.siteName}}</span>
            <span class="prop-sub">{{#if this.domain}}{{this.domain}}{{else}}Property {{this.propertyId}}{{/if}}</span>
          </div>

          <div class="prop-actions">
            {{#if this.activeUsers}}
            <div class="live-dot" title="{{this.activeUsers}} active user(s)"></div>
            {{/if}}

            <button type="button" class="prop-actions-toggle" aria-expanded="false"
              aria-controls="prop-actions-{{this.propertyId}}" title="Property actions">
              Actions
            </button>
            <div class="prop-actions-menu" id="prop-actions-{{this.propertyId}}" hidden>
              <a href="{{this.analyticsUrl}}" class="prop-action-link" data-card-action>
                Open analytics
              </a>
              {{#if this.websiteUrl}}
              <a href="{{this.websiteUrl}}" class="prop-action-link" target="_blank"
                rel="noopener noreferrer" data-card-action>
                Visit website
              </a>
              {{/if}}
            </div>
          </div>
        </div>

        <div class="prop-stats">
          <div class="prop-stat">
            <span class="prop-stat-num {{#if this.activeUsers}}green{{/if}}"
              data-target="{{this.activeUsers}}">{{this.activeUsers}}</span>
            <span class="prop-stat-label">active</span>
          </div>
          <div class="prop-stat">
            <span class="prop-stat-num" data-target="{{this.pageViews}}">{{this.pageViews}}</span>
            <span class="prop-stat-label">views</span>
          </div>
        </div>

        {{#if this.error}}
        <div class="prop-error-tag">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          No Access
        </div>
        {{/if}}
        </div>
    {{/each}}
  </div>

  {{!-- Shared card-detail modal (one instance, populated per-property on open) --}}
  <dialog class="card-modal" id="cardModal">
    <div class="card-modal-head">
      <div class="card-modal-title">
        <div class="card-modal-name" id="cardModalName"></div>
        <div class="card-modal-sub" id="cardModalSub"></div>
      </div>
      <div class="card-modal-actions">
        <a class="card-modal-btn" id="cardModalLink" href="#" target="_blank" rel="noopener noreferrer" title="Open property dashboard">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </a>
        <button type="button" class="card-modal-btn" id="cardModalClose" title="Close" aria-label="Close">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>
    <div class="card-modal-body" id="cardModalBody">
      <div class="cd-loading">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          style="animation:spin 700ms linear infinite">
          <path d="M21 12a9 9 0 1 1-6.219-8.56" />
        </svg>
        Loading…
      </div>
    </div>
  </dialog>

  {{!-- Footer --}}
  <div class="dash-foot">
    <div class="dash-foot-meta">
      <div class="foot-item">
        <span class="foot-key">Properties cached</span>
        <span class="foot-val" id="jsCacheAge">{{cacheAge}}</span>
      </div>
      <div class="foot-item">
        <span class="foot-key">Fetch time</span>
        <span class="foot-val">{{fetchDurationMs}}ms</span>
      </div>
      <div class="foot-item">
        <span class="foot-key">Cache TTL</span>
        <span class="foot-val">12 h</span>
      </div>
    </div>
    <div>
      <span>Run <code
          style="background:#eee;padding:2px 6px;border-radius:4px;font-size:10px">node app.js --refresh-cache</code> to
        force-refresh on startup</span>
    </div>
    <div class="foot-mcp" title="This project ships a standalone GA4 MCP server — see mcp-server/README.md">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="4" width="16" height="16" rx="3" />
        <path d="M9 9h.01M9 15h6M9 12h6" />
      </svg>
      <span>MCP server included · <code style="background:#eee;padding:1px 5px;border-radius:4px;font-size:10px">mcp-server/</code></span>
    </div>
  </div>

</div>

{{!-- Keyboard shortcut hints --}}
<div class="kbd-hint-bar">
  <span><kbd>R</kbd> Reload</span>
  <span><kbd>P</kbd> Privacy</span>
  <span><kbd>A</kbd> Auto</span>
  <span><kbd>G</kbd> Globe</span>
  <span><kbd>?</kbd> Help</span>
</div>
{{!-- JSON data for JS ──────────────────────────────────────────── --}}
<script>
  const PAGE_DATA = {{{ json_stringify data }}};
  const QUOTA = {{{ json_stringify quota }}};
  const CACHE_AGE = {{{ json_stringify cacheAge }}};
</script>
