{{!-- {{{json_stringify data}}} --}}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 font-heading my-10 transition-all">
  {{#each data}}
    <a href="{{this.dashboardUrl}}" target="_blank" rel="noopener noreferrer"
       class="block bg-white p-5 shadow shadow-gray-100 rounded-md transition-all hover:shadow-lg">
      <p class="text-xl font-bold text-center">
        {{this.siteName}}
      </p>
      <div class="grid grid-cols-2 gap-2 p-2">
        <div>
          <p>Active Users</p>
          <p>Page Views</p>
        </div>
        <div>
          <p>{{this.activeUsers}}</p>
          <p>{{this.pageViews}}</p>
        </div>
      </div>
    </a>
  {{/each}}
</div>
<script>
  const livedata =
  {{{json_stringify data}}}
  ;
</script>