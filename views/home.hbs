{{!-- {{{json_stringify data}}} --}}
<div class="grid grid-cols-4 gap-4  font-heading my-10">
  {{#each data}}
    <div class="bg-white p-5 shadow shadow-gray-100 rounded-md">
      <p class="text-xl font-bold text-center">
        {{this.rows.0.dimensionValues.0.value}}
      </p>
      <div class="grid grid-cols-2 gap-2 p-2">
      <div>
        {{#each this.metricHeaders}}
          <p>
            {{this.name}}
          </p>
        {{/each}}
      </div>
      <div>
        {{#each this.rows.0.metricValues}}
          <p>
            {{this.value}}
          </p>
        {{/each}}
      </div>



      </div>
    </div>
  {{/each}}
</div>
<script>
  const livedata =
  {{{json_stringify data}}}
  ;
</script>