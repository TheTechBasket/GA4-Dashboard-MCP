<!DOCTYPE html>
{{! TV board (/tv). Full screen, read from across a room. Widget tiles on a 12 x 12 GridStack grid:
    drag and resize them, put several widgets in one tile and they take turns. Press E to edit.
    Presets: ?layout=split (default), rotate, board. Each screen keeps its own layout in localStorage.
    Data: the same cached /api endpoints as /globe, polled at the quota-safe interval the server sends. }}
<html lang="en" data-theme="dark" data-preset="{{tvLayout}}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GA4 Dashboard · TV</title>
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/css/panel.css" />
<link rel="stylesheet" href="/vendor/gridstack/gridstack.min.css" />
<script>try{var t=new URLSearchParams(location.search).get('theme');if(t==='light')document.documentElement.setAttribute('data-theme','light')}catch(e){}</script>
<style>
  /* One type scale for the whole screen: 1rem is about 26px on a 1080p TV, 17px on a 720p one. */
  html { font-size: clamp(14px, calc(1.15vw + .35vh), 52px); background: var(--bg); color: var(--text); }
  body { margin: 0; font: 400 1rem/1.4 var(--font); overflow: hidden; -webkit-font-smoothing: antialiased; }
  ::selection { background: var(--accent-soft); color: var(--text); }
  .num { font-variant-numeric: tabular-nums; }
  body.idle, body.idle * { cursor: none !important; }

  #tv { position: fixed; inset: 0; display: grid; grid-template-rows: 1fr auto; transition: translate 2s var(--ease-out); }
  .stage { position: relative; min-height: 0; padding: .3rem; }
  .grid-stack { height: 100% !important; }
  .tile { position: relative; background: var(--surface); border-radius: 3px; overflow: hidden !important; container-type: size; }
  .tile.bare { background: transparent; }
  .wgt { position: absolute; inset: 0; padding: 1.6rem 1.9rem 1.2rem; display: flex; flex-direction: column; gap: 1rem; min-width: 0; opacity: 0; visibility: hidden; transition: opacity .6s var(--ease-out), visibility 0s .6s; }
  .wgt.on { opacity: 1; visibility: visible; transition: opacity .6s var(--ease-out); }
  .wgt h2 { margin: 0; font-size: 1.15rem; font-weight: 600; letter-spacing: -.011em; color: var(--text-2); }
  .tsteps { position: absolute; left: 1.9rem; right: 1.9rem; bottom: .5rem; display: flex; gap: .4rem; max-width: 14rem; }
  .tsteps i { flex: 1; height: .2rem; background: var(--surface-3); border-radius: 1px; overflow: hidden; }
  .tsteps i.on::before { content: ""; display: block; height: 100%; background: var(--text-2); transform-origin: left; animation: fill var(--dur, 20s) linear forwards; }
  body.paused .tsteps i.on::before { animation-play-state: paused; }
  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* live number: scales with its tile */
  .hero { justify-content: center; }
  .hero .lbl { color: var(--text-2); font-size: 1rem; font-weight: 500; display: flex; align-items: center; gap: .5rem; }
  .hero b { display: block; font-size: clamp(2.4rem, min(42cqh, 22cqi), 12rem); font-weight: 600; letter-spacing: -.03em; line-height: 1; }
  .dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--good); flex: none; animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .35; } }

  /* globe */
  .wgt[data-w="globe"] { padding: 0; }
  .wgt iframe { border: 0; width: 100%; height: 100%; display: block; background: var(--bg); }
  .gover { position: absolute; left: 1.9rem; top: 1.6rem; pointer-events: none; }
  .gover b { display: block; font-size: clamp(2.4rem, 9cqi, 6rem); font-weight: 600; letter-spacing: -.03em; line-height: 1; text-shadow: 0 2px 18px rgba(0,0,0,.45); }
  .gover span { font-size: 1.15rem; color: var(--text-2); font-weight: 500; }
  body.has-total .gover { display: none; }

  /* rows: sites, countries */
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; align-content: start; min-height: 0; flex: 1; overflow: hidden; }
  @container (min-width: 50rem) { .rows, .feed { font-size: 1.15rem; gap: 1.2rem; } .row svg { width: 8rem; height: 1.8rem; } }
  .row { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr) auto; grid-template-rows: auto auto; column-gap: .8rem; row-gap: .35rem; align-items: center; }
  .row img, .row .tile { width: 1.6rem; height: 1.6rem; border-radius: 2px; grid-row: 1 / 3; object-fit: cover; }
  .row .tile { display: grid; place-items: center; font-size: .8rem; font-weight: 600; color: #fff; }
  .row .nm { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row .ct { font-weight: 600; font-size: 1.2rem; text-align: right; }
  .row .bar { grid-column: 2 / 4; height: .3rem; background: var(--surface-3); border-radius: 1px; overflow: hidden; }
  .row .bar i { display: block; height: 100%; background: var(--accent-fg); transform-origin: left; transition: transform .8s var(--ease-out); }
  .row .meta { display: flex; gap: .7rem; align-items: center; justify-content: end; }
  .row svg { width: 5rem; height: 1.3rem; overflow: visible; }
  .row svg polyline { fill: none; stroke: var(--text-3); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .dl { font-size: .8rem; font-weight: 600; padding: .05rem .35rem; border-radius: 2px; background: var(--surface-3); color: var(--text-2); }
  .dl.up { background: var(--good-soft); color: var(--good); }
  .dl.dn { background: var(--warn-soft); color: var(--warn); }

  /* feed */
  .feed { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; align-content: start; min-height: 0; flex: 1; overflow: hidden; }
  .feed li { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr) auto; column-gap: .8rem; align-items: start; animation: in .6s var(--ease-out) both; }
  .feed img, .feed .noflag { width: 1.6rem; height: 1.2rem; border-radius: 2px; margin-top: .2rem; object-fit: cover; background: var(--surface-3); }
  .feed .pg { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .feed .sub { color: var(--text-2); font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .feed .ago { color: var(--text-3); font-size: .85rem; }
  .feed .key .pg::after { content: "Key event"; margin-left: .5rem; font-size: .7rem; font-weight: 600; padding: .05rem .35rem; border-radius: 2px; background: var(--accent-soft); color: var(--accent-fg); vertical-align: .15em; }
  @keyframes in { from { opacity: 0; translate: 0 -.4rem; } }

  /* spike */
  .spike-row { display: flex; align-items: baseline; gap: 0 1.6rem; flex-wrap: wrap; }
  .spike-big { font-size: clamp(1.8rem, 7cqi, 3.6rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.05; margin: 0; }
  .spike-big em { font-style: normal; color: var(--warn); }
  .spike-sub { color: var(--text-2); font-size: 1.15rem; margin: 0; }
  .refs { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .refs li { background: var(--surface-2); padding: .3rem .7rem; border-radius: 2px; font-size: .95rem; }
  .refs b { margin-left: .4rem; }

  /* status bar */
  .bar-b { display: flex; align-items: center; gap: 1.6rem; padding: .7rem 2.6rem; font-size: .85rem; color: var(--text-2); background: var(--surface); }
  .bar-b .live { display: flex; align-items: center; gap: .5rem; color: var(--text); font-weight: 600; font-size: 1rem; }
  body.has-total .bar-b .live { display: none; }
  .ebtn { font: inherit; font-size: .85rem; color: var(--text-2); background: var(--surface-2); border: 0; border-radius: 2px; padding: .3rem .7rem; cursor: pointer; }
  .ebtn:hover { color: var(--text); background: var(--surface-3); }
  .ebtn.pri { background: var(--accent); color: #fff; }
  body.idle:not(.editing) .bar-b .ebtn { visibility: hidden; }

  /* edit mode */
  .ebar { display: none; position: fixed; top: .8rem; left: 50%; translate: -50% 0; z-index: 20; gap: .5rem; align-items: center; padding: .5rem; background: var(--surface-2); border-radius: 3px; box-shadow: 0 8px 30px rgba(0,0,0,.4); font-size: .85rem; }
  body.editing .ebar { display: flex; }
  .ebar select { font: inherit; color: var(--text); background: var(--surface-3); border: 0; border-radius: 2px; padding: .3rem .5rem; }
  .ebar .msg { color: var(--warn); }
  .tedit { display: none; position: absolute; inset: auto .5rem .5rem .5rem; z-index: 5; gap: .35rem; flex-wrap: wrap; align-items: center; padding: .4rem; background: var(--surface-2); border-radius: 3px; font-size: .8rem; }
  body.editing .tedit { display: flex; }
  body.editing .tile { outline: 2px dashed var(--surface-3); outline-offset: -2px; cursor: move; }
  .chip { display: inline-flex; align-items: center; gap: .3rem; background: var(--surface-3); border-radius: 2px; padding: .15rem .2rem .15rem .5rem; }
  .chip button, .tedit .x { font: inherit; border: 0; background: none; color: var(--text-2); cursor: pointer; padding: .1rem .35rem; }
  .chip button:hover, .tedit .x:hover { color: var(--warn); }
  .tedit select { font: inherit; color: var(--text); background: var(--surface-3); border: 0; border-radius: 2px; padding: .15rem .3rem; }
  .tedit .x { margin-left: auto; }
  .quota { display: flex; align-items: center; gap: .6rem; margin-left: auto; }
  .quota .m { width: 6rem; height: .3rem; background: var(--surface-3); border-radius: 1px; overflow: hidden; }
  .quota .m i { display: block; height: 100%; background: var(--good); transform-origin: left; transition: transform .8s var(--ease-out); }
  .quota.low .m i { background: var(--warn); } .quota.low { color: var(--warn); }
  .clock { font-weight: 600; color: var(--text); font-size: 1rem; }
  .demo { font-size: .75rem; font-weight: 600; padding: .05rem .4rem; border-radius: 2px; background: var(--warn-soft); color: var(--warn); }
  .empty { color: var(--text-3); }
  .rows > [hidden], .feed > [hidden] { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .wgt, .row .bar i, .quota .m i, #tv { transition: none !important; }
    .feed li, .dot { animation: none; }
  }
</style>
</head>
<body>
<main id="tv">
  <section class="stage"><div class="grid-stack" id="grid"></div></section>

  <footer class="bar-b">
    <span class="live"><span class="dot" aria-hidden="true"></span><span class="num" data-total>0</span> live</span>
    <button type="button" class="ebtn" id="editBtn" title="Move, resize and pick widgets (E)">Edit layout</button>
    {{#if demo}}<span class="demo">Demo data</span>{{/if}}
    <span id="fresh" class="num">Loading</span>
    <span class="quota" id="quota" title="GA4 quota used this hour by the busiest property"><span class="m"><i style="transform:scaleX(0)"></i></span><span class="num" id="quotaTxt"></span></span>
    <span class="clock num" id="clock"></span>
  </footer>
</main>
<div class="ebar" role="toolbar" aria-label="Edit layout">
  <label>Start from <select id="preset"><option value="split">Split</option><option value="rotate">Rotate</option><option value="board">Board</option></select></label>
  <button type="button" class="ebtn" id="addTile">Add tile</button>
  <span class="msg" id="emsg" role="status"></span>
  <button type="button" class="ebtn pri" id="doneBtn">Done</button>
</div>
<script src="/vendor/gridstack/gridstack-all.js"></script>
<script src="/js/letterTile.js"></script>
<script src="/js/tv.js"></script>
</body>
</html>
